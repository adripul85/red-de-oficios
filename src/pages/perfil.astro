---
import Layout from "../layouts/Layout.astro";
import { db } from "../firebase/client";
import { doc, getDoc, updateDoc, increment } from "firebase/firestore";

import ModernProfileCard from "../components/ModernProfileCard.astro";
import ProfileLightbox from "../components/profile/ProfileLightbox.jsx";
import ProfileBudgetModal from "../components/profile/ProfileBudgetModal.jsx";
import ProfileReviews from "../components/profile/ProfileReviews.jsx";


const id = Astro.url.searchParams.get("id");
let profesional = null;
let idProfesional = null;

if (id) {
    try {
        const docRef = doc(db, "profesionales", id);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
            profesional = docSnap.data();
            idProfesional = docSnap.id;
        }
    } catch (e) {
        console.error("Error:", e);
    }
}

if (!profesional) return Astro.redirect("/");

// SI TIENE SLUG Y MODO LANDING ACTIVADO, REDIRECCIONAR A LA URL LIMPIA
if (profesional.slug && profesional.web_propia) {
    return Astro.redirect(`/${profesional.slug}`);
}


// --- LÓGICA DE VISUALIZACIÓN ---

const esExperto =
    profesional.plan === "experto" || profesional.plan === "semestral";
const mostrarComoLanding = esExperto && profesional.web_propia;
const promedio = profesional.puntuacion || profesional.promedio || 0.0; // Standardized fallback to 0.0
const votos = profesional.total_valoraciones || profesional.total_votos || 0;
const ubicacion = profesional.zona || "Argentina";

const portfolioJson = JSON.stringify(profesional.portfolio || []);
const serviciosJson = JSON.stringify(profesional.servicios_lista || []);
const profesionalJson = JSON.stringify(profesional);


const seoTitle = profesional.seo_nombre || `${profesional.nombre} | ${profesional.rubro_principal} en ${ubicacion} | deOficiosArgentina`;
const seoDescription =
    profesional.seo_profesion ||
    `Contactá a ${profesional.nombre}, experto en ${profesional.rubro_principal} en ${ubicacion}. ⭐️ ${promedio.toFixed(1)}/5 (${votos} opiniones). Encontrá el mejor servicio en deOficiosArgentina.`;

const seoImage = profesional.foto && !profesional.foto.includes("ui-avatars") 
    ? profesional.foto 
    : "https://reddeoficio.com/icon-512.png";

const serviceIcons: Record<string, string> = {
    "Aire Acondicionado": "❄️",
    Electricidad: "⚡",
    Electricista: "⚡",
    Gasista: "🔥",
    Plomero: "🚰",
    Plomería: "🚰",
    Pintor: "🎨",
    Albañil: "🧱",
    Construcción: "🏗️",
    Flete: "🚚",
    Mudanza: "📦",
    Jardinería: "🌿",
    Limpieza: "🧹",
    Carpintero: "🪚",
    Herrero: "⚔️",
    Mecánico: "🔧",
    Cerrajero: "🔑",
    Techista: "🏠",
    Durlock: "🏗️",
};

const getServiceIcon = (serviceName: any) => {
    if (!serviceName || typeof serviceName !== "string") return "🛠️";

    // Buscar coincidencia parcial
    const lowerName = serviceName.toLowerCase();
    for (const key in serviceIcons) {
        if (lowerName.includes(key.toLowerCase())) {
            return serviceIcons[key];
        }
    }
    return "🛠️"; // Icono por defecto
};

const allServices = Array.from(new Set([
    ...(profesional.servicios_lista || []).map((s: any) => typeof s === 'object' ? (s.nombre || s.label || s.servicio || "Servicio") : s),
    ...(profesional.etiquetas || [])
])).filter(Boolean);

const mappedServices = allServices
    .slice(0, 4)
    .map((name: any) => {
        return {
            label: name,
            icon: getServiceIcon(name),
        };
    });

// --- GAMIFICATION CALCULATION (Server Side) ---
let xp = 0;
// Base
if (profesional.foto && !profesional.foto.includes("ui-avatars")) xp += 100;
if (profesional.rubro_principal) xp += 50;
if (profesional.zona) xp += 50;

// Missions
const hasFullProfile = (profesional.foto && !profesional.foto.includes("ui-avatars")) && profesional.rubro_principal && profesional.zona;
if (hasFullProfile) xp += 200;

const hasPortfolio = (profesional.portfolio || []).length >= 3;
if (hasPortfolio) xp += 150;

const hasGoodRating = (profesional.puntuacion || profesional.promedio || 0) >= 4.5;
if (hasGoodRating) xp += 300;

// Levels
const levels = [
    { name: "Novato 🌱", threshold: 0 },
    { name: "Aprendiz 🔨", threshold: 500 },
    { name: "Profesional 👷", threshold: 1500 },
    { name: "Experto 🦁", threshold: 5000 },
    { name: "Maestro 👑", threshold: 50000 },

];

let currentLevel = levels[0];
for (let i = 0; i < levels.length; i++) {
    if (xp >= levels[i].threshold) {
        currentLevel = levels[i];
    }
}

// --- RESTRICCIONES Y BLOQUEO ---
const now = new Date();
const trialEndsAt = profesional.trialEndsAt?.toDate ? profesional.trialEndsAt.toDate() : (profesional.trialEndsAt ? new Date(profesional.trialEndsAt) : null);
const isTrialExpired = profesional.plan === "prueba" && trialEndsAt && trialEndsAt < now;
const isLimitReached = (profesional.plan === "semilla" || !profesional.plan) && (profesional.contactos_whatsapp_mes >= 60);

const isBlocked = isTrialExpired || isLimitReached;
const blockReason = isTrialExpired ? "trial_expired" : (isLimitReached ? "limit_reached" : "");

const schemaData = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": profesional.nombre,
    "image": seoImage,
    "description": seoDescription,
    "telephone": profesional.telefono || "",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": ubicacion,
        "addressCountry": "AR"
    },
    "priceRange": profesional.precio_min ? `$${profesional.precio_min} - $${profesional.precio_max}` : "$$",
    "aggregateRating": votos > 0 ? {
        "@type": "AggregateRating",
        "ratingValue": promedio.toFixed(1),
        "reviewCount": votos
    } : undefined,
    "url": Astro.url.href
};
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={profesional.foto}
    hideHeader={mostrarComoLanding}
    hideFooter={mostrarComoLanding}
    hideIA={mostrarComoLanding}
>
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaData)} />
    
    <!-- Map & PDF Scripts (Now imported in module script) -->
    
    <script is:inline>
        // Map Initialization
        document.addEventListener("astro:page-load", () => {
            try {
                const mapContainer = document.getElementById("mini-map");
                if (mapContainer && window.L) {
                    const lat = parseFloat(mapContainer.dataset.lat);
                    const lng = parseFloat(mapContainer.dataset.lng);

                    if (!isNaN(lat) && !isNaN(lng)) {
                        if (mapContainer._leaflet_id) return; // Prevent re-initialization

                        const map = L.map("mini-map", {
                            center: [lat, lng],
                            zoom: 15,
                            attributionControl: false,
                            zoomControl: false,
                        });

                        L.tileLayer(
                            "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                            {
                                maxZoom: 19,
                            },
                        ).addTo(map);

                        L.circle([lat, lng], {
                            color: '#f97316', // Primary Orange
                            fillColor: '#f97316',
                            fillOpacity: 0.15,
                            radius: 800, // 800 meters approx
                            weight: 1
                        }).addTo(map);

                        // Add text label for context
                        L.popup({
                            closeButton: false,
                            autoClose: false,
                            closeOnClick: false,
                            className: 'zone-popup text-center font-bold text-xs',
                            offset: [0, -10]
                        })
                        .setLatLng([lat, lng])
                        .setContent('<div class="text-orange-600">Zona de Cobertura</div>')
                        .openOn(map);
                    }
                }
            } catch(e) { console.error("Error in profile scripts:", e); }
        });
    </script>

    {
        mostrarComoLanding ? (
            /* MODO LANDING NUEVO */
            <div id="landing-profile-container" data-id={idProfesional} data-profesional-json={profesionalJson} class="landing-body font-sans min-h-screen bg-slate-100 flex flex-col items-center justify-start py-10 px-4 overflow-x-hidden">
                  <ModernProfileCard
                    name={profesional.nombre}
                    role={
                        profesional.seo_profesion || profesional.rubro_principal
                    }
                    avatar={profesional.foto}
                    location={ubicacion}
                    rating={promedio.toFixed(1)}
                    isBlocked={isBlocked}
                    blockReason={blockReason}
                    priceInfo={profesional.presupuestos_config?.activo ? "Presupuestos sin cargo" : (profesional.precio_visita ? `Precio visita: $ ${Number(profesional.precio_visita).toLocaleString('es-AR')}` : "Consultar precio")}
                    services={mappedServices}
                    bio={profesional.descripcion}
                    experience={profesional.experiencia}
                    category={profesional.rubro_principal}
                    tags={profesional.etiquetas}
                    cuit={profesional.cuit}
                    idPro={idProfesional}
                    idName={profesional.nombre}
                    isBlocked={isBlocked}
                    
                    /* Security Feature props */
                    isFake={profesional.is_fake}
                    whatsappUrl={`https://wa.me/549${profesional.telefono}?text=${encodeURIComponent(`Hola ${profesional.nombre}, te contacto desde deOficiosArgentina.`)}`}
                />
                <div class="max-w-[360px] w-full mx-auto mt-8 bg-white/50 backdrop-blur-sm rounded-3xl p-6 border border-white/40 shadow-xl">
                   <ProfileReviews client:visible idProfesional={idProfesional} />
                </div>
            </div>
        ) : (
            /* MODO DIRECTORIO (NUEVO DISEÑO) */
            <div id="profile-directory" data-id={idProfesional} data-profesional-json={JSON.stringify(profesional)} class="bg-background-light font-sans min-h-screen text-neutral-black">
                <div class="max-w-7xl mx-auto px-4 md:px-8 pt-8">
                    <a href="/resultados" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">arrow_back</span> Volver a Resultados
                    </a>
               </div>

               {
                   profesional.is_fake && (
                       <div class="max-w-7xl mx-auto px-4 md:px-8 mt-4">
                           <div class="bg-orange-600/10 border border-orange-600/20 rounded-2xl p-4 flex items-center gap-4">
                               <span class="text-2xl">⚠️</span>
                               <div>
                                   <p class="text-orange-900 font-black text-sm uppercase tracking-tight">Perfil de Demostración</p>
                                   <p class="text-orange-800/80 text-xs font-bold">Este perfil contiene información ficticia generada para pruebas visuales. Los contactos no son reales.</p>
                               </div>
                           </div>
                       </div>
                   )
               }

               <main class="max-w-7xl mx-auto px-4 md:px-8 py-10">
                    <!-- NEW PREMIUM HEADER (REFERENCE BASED) - REPLACES OLD SECTION -->
                    <section class="bg-white rounded-[2.5rem]  overflow-hidden shadow-xl border border-slate-100 mb-12 animate-fade-in-up">
                        <!-- TOP GRADIENT SECTION -->
                        <div class="relative h-64 bg-gradient-to-br from-orange-500 via-orange-400 to-amber-300 flex items-center justify-center rounded-2xl">
                            <!-- Profile Image -->
                            <div class="relative group">
                                <img
                                    src={profesional.foto || "https://ui-avatars.com/api/?name=" + profesional.nombre}
                                    class={`w-40 h-40 rounded-full object-cover border-4 border-white shadow-2xl transition-transform duration-500 group-hover:scale-105 ${isBlocked ? 'filter blur-[2px] grayscale-[0.5]' : ''}`}
                                    alt={profesional.nombre}
                                />
                                {isBlocked && (
                                    <div class="absolute inset-0 z-40 flex items-center justify-center bg-black/40 rounded-full">
                                         <div class="bg-white/90 backdrop-blur-md px-4 py-2 rounded-xl border border-orange-500 shadow-xl transform rotate-3 scale-75">
                                            <span class="text-slate-900 font-extrabold text-[10px] uppercase tracking-tighter">PERFIL EN PAUSA</span>
                                        </div>
                                    </div>
                                )}
                                {profesional.plan === "experto" && !isBlocked && (
                                    <div class="absolute -bottom-2 right-4 bg-yellow-400 text-slate-900 p-1.5 rounded-full border-2 border-white shadow-lg animate-bounce">
                                        <span class="material-symbols-outlined text-sm font-bold">star</span>
                                    </div>
                                )}
                            </div>
                        </div>

                        <!-- INFO CARD SECTION (OVERLAPPING) -->
                        <div class="relative bg-white -mt-12 rounded-t-[3rem] px-8 pt-10 pb-12 shadow-inner">
                            <div class="flex flex-col md:flex-row justify-between gap-8 items-start">
                                <!-- Left: Identity & Badges -->
                                <div class="flex-1 space-y-4">
                                    <div class="flex flex-wrap items-center gap-4">
                                        <div class="flex flex-col">
                                            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight leading-none">
                                                {profesional.nombre}
                                            </h1>
                                            {profesional.nombre_fantasia && (
                                                <span class="text-sm font-bold text-slate-400 mt-1">{profesional.nombre_fantasia}</span>
                                            )}
                                            {profesional.cuit && (
                                                <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest mt-1">CUIT/CUIL: {profesional.cuit}</span>
                                            )}
                                        </div>
                                        
                                        <!-- Badges Pill -->
                                        <div class="flex items-center gap-2">
                                            <span class="bg-slate-900 text-white text-[10px] font-black px-4 py-2 rounded-full tracking-[0.2em] uppercase flex items-center gap-2 shadow-sm">
                                                {currentLevel.name.split(' ')[0]}
                                                <span class="material-symbols-outlined text-[12px]">handyman</span>
                                            </span>
                                            
                                            <!-- Gamification Icons -->
                                            <div class="flex flex-wrap gap-2 items-start">
                                                {hasFullProfile && (
                                                    <div class="flex flex-col items-center group">
                                                        <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center border-2 border-white shadow-sm transition-transform group-hover:scale-110" title="Perfil Completo">🏅</div>
                                                        <span class="text-[8px] font-black text-amber-600 uppercase tracking-tighter text-center leading-[1] mt-1">Perfil<br/>Completo</span>
                                                    </div>
                                                )}
                                                {hasPortfolio && (
                                                    <div class="flex flex-col items-center group">
                                                        <div class="w-8 h-8 rounded-full bg-orange-50 flex items-center justify-center border-2 border-white shadow-sm transition-transform group-hover:scale-110" title="Portfolio Destacado">🎨</div>
                                                        <span class="text-[8px] font-black text-orange-600 uppercase tracking-tighter text-center leading-[1] mt-1">Portfolio<br/>Destacado</span>
                                                    </div>
                                                )}
                                                {hasGoodRating && (
                                                    <div class="flex flex-col items-center group">
                                                        <div class="w-8 h-8 rounded-full bg-yellow-50 flex items-center justify-center border-2 border-white shadow-sm transition-transform group-hover:scale-110" title="Excelente Reputación">⭐</div>
                                                        <span class="text-[8px] font-black text-yellow-600 uppercase tracking-tighter text-center leading-[1] mt-1">Excelente<br/>Reputación</span>
                                                    </div>
                                                )}
                                                {profesional.verificado && (
                                                    <div class="flex flex-col items-center group">
                                                        <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center border-2 border-white shadow-sm transition-transform group-hover:scale-110" title="Identidad Verificada">🛡️</div>
                                                        <span class="text-[8px] font-black text-blue-600 uppercase tracking-tighter text-center leading-[1] mt-1">Identidad<br/>Verificada</span>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>

                                    <p class="text-slate-400 font-bold text-xs uppercase tracking-widest flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm text-orange-500">location_on</span>
                                        <span class="capitalize">{ubicacion}</span>
                                        <span class="w-1 h-1 bg-slate-200 rounded-full"></span>
                                        <span class={profesional.verificado ? "text-orange-600" : "text-slate-400"}>
                                            {profesional.verificado ? "Identidad Verificada" : "Perfil Registrado"}
                                        </span>
                                    </p>

                                    <!-- Rating & Category -->
                                    <div class="flex flex-wrap items-center gap-6 pt-2">
                                        <div class="flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-100">
                                            <span class="text-orange-500 font-black text-lg">★</span>
                                            <span class="text-slate-900 font-extrabold text-lg">{promedio.toFixed(1)}</span>
                                            <span class="text-slate-400 text-xs font-bold uppercase tracking-wide">({votos} reseñas)</span>
                                        </div>

                                        <div class="flex items-center gap-2 text-slate-500 font-bold text-sm bg-slate-50 px-4 py-2 rounded-2xl border border-slate-100">
                                            <span class="material-symbols-outlined text-lg text-slate-400">work</span>
                                            {profesional.rubro_principal}
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: CTAs -->
                                <div class="flex items-center gap-4 w-full md:w-auto">
                                    
                                    <!-- Favorite Button -->
                                    <button
                                        id="btn-toggle-fav"
                                        class="w-14 h-14 rounded-full bg-red-50 text-red-500 flex items-center justify-center shadow-lg border-2 border-white hover:scale-110 transition-all shrink-0 active:scale-95"
                                    >
                                        <span class="material-symbols-outlined font-bold">favorite</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- NAV TABS -->
                    <nav class="flex border-b border-neutral-gray-light mb-10 overflow-x-auto">
                        <a class="flex-shrink-0 border-b-4 border-primary px-8 py-5 text-sm font-extrabold text-neutral-black tracking-widest uppercase" href="#sobre-mi">Sobre mí</a>
                        <a class="flex-shrink-0 border-b-4 border-transparent px-8 py-5 text-sm font-bold text-neutral-gray hover:text-primary transition-colors tracking-widest uppercase" href="#portfolio">Trabajos</a>
                        <a class="flex-shrink-0 border-b-4 border-transparent px-8 py-5 text-sm font-bold text-neutral-gray hover:text-primary transition-colors tracking-widest uppercase" href="#reviews-section">Opiniones</a>
                    </nav>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start mt-12">
                        <!-- MAIN CONTENT column -->
                        <div class="lg:col-span-8 space-y-16">
                            
                            <!-- ABOUT SECTION -->
                            <section id="sobre-mi" class="bg-white rounded-xl p-8 md:p-10 shadow-subtle border border-neutral-gray-light">
                                <h2 class="text-lg font-black text-neutral-black mb-6 tracking-tight">Experiencia y Trayectoria</h2>
                                <div class="space-y-4 text-neutral-gray-dark leading-relaxed text-sm whitespace-pre-line">
                                    {profesional.descripcion || "Este profesional no ha detallado su experiencia aún."}
                                </div>

                                <div class="mt-10">
                                    <h3 class="text-xs font-black text-neutral-gray uppercase tracking-[0.2em] mb-6">Servicios Ofrecidos</h3>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        {allServices.map((s: any) => (
                                            <div class="flex items-center gap-3 p-3 rounded-xl bg-white border border-neutral-gray-light hover:border-primary/40 transition-colors">
                                                <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                                                <span class="text-xs font-bold text-neutral-black capitalize">{s}</span>
                                            </div>
                                        ))}
                                        {allServices.length === 0 && (
                                            <p class="text-sm text-gray-500 italic">No se especificaron servicios ni etiquetas.</p>
                                        )}
                                    </div>
                                </div>
                            </section>

                            <!-- PORTFOLIO SECTION -->
                            {profesional.portfolio && profesional.portfolio.length > 0 && (
                                <section id="portfolio" class="mb-24">
                                    <div class="flex justify-between items-center mb-10">
                                        <h2 class="text-2xl font-black text-slate-900 tracking-tight uppercase">Portafolio Destacado</h2>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                                        {profesional.portfolio.map((img: any, index: number) => {
                                            const isLegacy = typeof img === "string";
                                            const url = isLegacy ? img : (img.url || img.URL || "");
                                            const title = isLegacy ? "" : (img.titulo || "");
                                            const desc = isLegacy ? "" : (img.descripcion || "");
                                            const date = isLegacy ? "" : (img.fecha || "");
                                            
                                            if (!url) return null;
                                            return (
                                                <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-slate-100 cursor-pointer open-lightbox" data-index={index}>
                                                    <div class="relative h-64 overflow-hidden bg-slate-50">
                                                        <img 
                                                            src={url} 
                                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                                            alt={title || "Foto de trabajo"}
                                                            loading="lazy"
                                                        />
                                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                                                            <span class="bg-white/20 backdrop-blur-md text-white text-[10px] font-black px-4 py-2 rounded-full tracking-widest uppercase border border-white/30">Ver pantalla completa</span>
                                                        </div>
                                                    </div>
                                                    {(title || desc || date) && (
                                                        <div class="p-6 space-y-2">
                                                            {title && <h4 class="font-black text-slate-900 text-lg leading-tight">{title}</h4>}
                                                            {desc && <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed">{desc}</p>}
                                                            {date && (
                                                                <div class="flex items-center gap-2 text-[10px] font-black text-orange-600 uppercase tracking-widest pt-2">
                                                                    <span class="material-symbols-outlined text-sm">calendar_today</span>
                                                                    {date}
                                                                </div>
                                                            )}
                                                        </div>
                                                    )}
                                                </div>
                                            );
                                        })}
                                    </div>
                                </section>
                            )}

                            <div class="h-32"></div> <!-- Substantial air before reviews -->

                            <!-- REVIEWS SECTION -->
                            <ProfileReviews client:visible idProfesional={idProfesional} />

                        </div>

                        <!-- SIDEBAR -->
                        <aside class="lg:col-span-4 space-y-12 lg:sticky lg:top-24">
                            
                             <!-- Contact Card -->
                            <div class="sticky-card bg-white rounded-2xl p-8 shadow-elevated border border-neutral-gray-light z-40">
                                <div class="mb-8">
                                    <h3 class="text-2xl font-black text-neutral-black mb-2">Contratación</h3>
                                    <div class="flex items-center gap-2 text-sm text-green-600 font-bold uppercase tracking-widest">
                                        <span class="size-2.5 bg-green-500 rounded-full animate-pulse shadow-sm"></span>
                                        Disponible
                                    </div>
                                </div>
                                <div class="space-y-4">
                                     {profesional.telefono && (
                                        <button 
                                            id="btn-whatsapp-contact"
                                            data-whatsapp={profesional.telefono}
                                            data-pro-id={idProfesional}
                                            data-pro-name={profesional.nombre}
                                            class="w-full flex items-center justify-center gap-3 bg-[#25D366] text-white rounded-xl py-4.5 font-black shadow-lg hover:opacity-95 transition-all text-base h-16">
                                            <span class="text-2xl">💬</span> WhatsApp
                                        </button>
                                     )}
                                     
                                     {profesional.servicios_lista?.length > 0 && (profesional.plan === "experto" || profesional.plan === "semestral") && (
                                        <button onclick="window.openBudgetModal()" class="w-full flex items-center justify-center gap-3 bg-slate-400 text-white rounded-xl py-4.5 font-black shadow-lg hover:bg-primary transition-all text-base h-16">
                                            <span class="text-2xl">📄</span> Ver Presupuestos
                                        </button>
                                     )}
                                </div>
                                <div class="mt-10 pt-8 border-t border-neutral-gray-light space-y-5">
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Zona</span>
                                        <span class="font-black text-neutral-black text-right">{ubicacion}</span>
                                    </div>
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Presupuesto</span>
                                        <span class="font-black text-primary">
                                            {profesional.presupuestos_config?.activo ? "Sin Cargo" : "Consultar"}
                                        </span>
                                    </div>
                                    <div class="flex justify-between items-center text-sm">
                                        <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Factura</span>
                                        <span class="font-black text-neutral-black">
                                            {
                                                profesional.emite_factura 
                                                    ? `Sí ${Array.isArray(profesional.tipo_factura) 
                                                        ? (profesional.tipo_factura.length > 0 ? `(${profesional.tipo_factura.join("/")})` : "(A/B/C)")
                                                        : (profesional.tipo_factura ? `(${profesional.tipo_factura})` : "(A/B/C)")}`
                                                    : "No especificado"
                                            }
                                        </span>
                                    </div>

                                    {profesional.garantia?.ofrece && (
                                        <div class="flex justify-between items-center text-sm">
                                            <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Garantía</span>
                                            <span class="font-black text-green-600">
                                                {profesional.garantia.tiempo ? `${profesional.garantia.tiempo} días` : "Sí"}
                                            </span>
                                        </div>
                                    )}

                                    {profesional.trabaja_con_equipo && (
                                        <div class="flex justify-between items-center text-sm">
                                            <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Modalidad</span>
                                            <span class="font-black text-neutral-black">Con Equipo</span>
                                        </div>
                                    )}

                                    {profesional.formas_pago && profesional.formas_pago.length > 0 && (
                                        <div class="flex flex-col gap-1 text-sm pt-2 border-t border-dashed border-neutral-gray-light">
                                            <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Medios de Pago</span>
                                            <div class="flex flex-wrap gap-1">
                                                {profesional.formas_pago.map((pago: string) => (
                                                    <span class="bg-slate-50 text-slate-600 px-2 py-0.5 rounded textxs border border-slate-100">{pago}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}

                                    {profesional.zonas && profesional.zonas.length > 0 && (
                                        <div class="flex flex-col gap-2 text-sm pt-4 border-t border-dashed border-neutral-gray-light">
                                            <span class="text-neutral-gray font-bold uppercase tracking-wider text-[11px]">Zonas de Cobertura</span>
                                            <div class="flex flex-wrap gap-1.5">
                                                {profesional.zonas.map((z: any) => (
                                                    <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded-lg text-xs font-semibold border border-blue-100">
                                                        {typeof z === 'object' ? (z.nombre || z.label) : z}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    <div class="pt-4">
                                         <button 
                                            id="btn-report-profile" 
                                            class="text-red-400 text-xs font-bold hover:text-red-500 flex items-center gap-1 justify-center w-full transition-colors"
                                            onclick="document.getElementById('report-modal').classList.remove('hidden')"
                                        >
                                            <span>🚩</span> Reportar este perfil
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            {profesional.ubicacion_exacta?.activo && profesional.ubicacion_exacta?.lat && (
                                <div class="bg-white rounded-2xl p-2 border border-neutral-gray-light shadow-sm mt-12">
                                     <div id="mini-map" class="w-full h-48 rounded-xl bg-gray-200" data-lat={profesional.ubicacion_exacta.lat} data-lng={profesional.ubicacion_exacta.lng}></div>
                                </div>
                            )}

                            <div class="bg-primary/5 rounded-2xl p-8 border border-primary/20">
                                <h4 class="font-black text-primary mb-3 flex items-center gap-2 uppercase text-xs tracking-[0.15em]">
                                    <span class="material-symbols-outlined text-xl">shield</span>
                                    Garantía deOficiosArgentina
                                </h4>
                                <p class="text-sm text-neutral-gray-dark leading-relaxed font-semibold">
                                    Los trabajos realizados cuentan con el respaldo de nuestra comunidad. Verifica siempre la identidad del profesional.
                                </p>
                            </div>
                        </aside>
                    </div>
                </main>
            </div>
        )
    }

    <ProfileLightbox client:load images={profesional.portfolio || []} />
    <ProfileBudgetModal
        client:load
        services={profesional.servicios_lista}
        proName={profesional.nombre}
        proRubro={profesional.rubro_principal}
        proTel={profesional.telefono}
        proMat={profesional.matricula}
    />

    <script>
        import { auth, db } from "../firebase/client";
        import { doc, getDoc, updateDoc, arrayUnion, setDoc, addDoc, collection, serverTimestamp, increment } from "firebase/firestore";
        import { onAuthStateChanged } from "firebase/auth";
        import L from "leaflet";
        import "leaflet/dist/leaflet.css";
        import { jsPDF } from "jspdf";
        import { registrarClickWhatsApp } from '../scripts/plan-restrictions.js';

        document.addEventListener("astro:page-load", async () => {
            // --- MAP LOGIC (Moved here to use imported Leaflet) ---
            try {
                const mapContainer = document.getElementById("mini-map");
                if (mapContainer) {
                    const lat = parseFloat(mapContainer.dataset.lat);
                    const lng = parseFloat(mapContainer.dataset.lng);

                    if (!isNaN(lat) && !isNaN(lng)) {
                         // @ts-ignore
                        if (mapContainer._leaflet_id) {
                            // Already initialized
                        } else {
                            const map = L.map("mini-map", {
                                center: [lat, lng],
                                zoom: 15,
                                attributionControl: false,
                                zoomControl: false,
                            });

                            L.tileLayer(
                                "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                                { maxZoom: 19 }
                            ).addTo(map);

                            L.circle([lat, lng], {
                                color: '#f97316',
                                fillColor: '#f97316',
                                fillOpacity: 0.15,
                                radius: 800,
                                weight: 1
                            }).addTo(map);

                            L.popup({
                                closeButton: false,
                                autoClose: false,
                                closeOnClick: false,
                                className: 'zone-popup text-center font-bold text-xs',
                                offset: [0, -10]
                            })
                            .setLatLng([lat, lng])
                            .setContent('<div class="text-orange-600">Zona de Cobertura</div>')
                            .openOn(map);
                        }
                    }
                }
            } catch(e) { console.error("Error in map script:", e); }


            const contactButtons = document.querySelectorAll("#btn-whatsapp-contact");
            const landingBtn = document.getElementById("btn-whatsapp-landing");
            const profileDiv = document.getElementById("profile-directory");
            const landingDiv = document.getElementById("landing-profile-container");
            
            let idProfesional = null;
            let profesionalJson = {};

            if (profileDiv) {
                idProfesional = profileDiv.dataset.id;
                try {
                    profesionalJson = JSON.parse(profileDiv.dataset.profesionalJson || "{}");
                } catch(e) {}
            } else if (landingDiv) {
                 idProfesional = landingDiv.dataset.id;
                 try {
                    profesionalJson = JSON.parse(landingDiv.dataset.profesionalJson || "{}");
                } catch(e) {}
            }

            // Centralized Tracking is now handled by registrarClickWhatsApp
            // @ts-ignore
            window.registrarClickWhatsApp = registrarClickWhatsApp;
            
            // Register local trackWhatsApp for legacy if any (optional)
            // @ts-ignore
            window.registrarClickWhatsApp = registrarClickWhatsApp;

            // WhatsApp Contact Logic for Directory Buttons
            if (contactButtons.length > 0) {
                contactButtons.forEach(btnContact => {
                    btnContact.addEventListener("click", async (e) => {
                        e.preventDefault();
                        
                        const proId = btnContact.getAttribute("data-pro-id") || idProfesional;
                        const proName = btnContact.getAttribute("data-pro-name");
                        const whatsapp = btnContact.getAttribute("data-whatsapp");

                        if (!proId || !proName || !whatsapp) return;

                        const tracked = await registrarClickWhatsApp(proId);
                        if (!tracked) return;

                        const waUrl = `https://wa.me/549${whatsapp}?text=${encodeURIComponent(`Hola ${proName}, te contacto desde deOficiosArgentina.`)}`;
                        window.open(waUrl, "_blank");

                        // Feedback Modal logic follows...
                        handleFeedbackModal(proName);
                    });
                });
            }

            // WhatsApp Contact Logic for Landing Button
            if (landingBtn) {
                landingBtn.addEventListener("click", async (e) => {
                    // El botón ya tiene href con target="_blank", solo trackeamos
                    const proId = landingBtn.getAttribute("data-pro-id") || idProfesional;
                    const proName = landingBtn.getAttribute("data-pro-name") || "el profesional";

                    const tracked = await registrarClickWhatsApp(proId);
                    if (!tracked) {
                        e.preventDefault();
                        return;
                    }
                    
                    handleFeedbackModal(proName);
                });
            }

            function handleFeedbackModal(proName) {
                // @ts-ignore
                const Swal = window.Swal;
                setTimeout(() => {
                    if (!Swal) return;
                    Swal.fire({
                        title: "¿Pudiste contactarlo? 🤔",
                        text: "Tu feedback nos ayuda a mejorar.",
                        icon: "question",
                        showDenyButton: true,
                        showCancelButton: true,
                        confirmButtonText: "✅ Sí, hablamos",
                        denyButtonText: "🚫 No contestó",
                        cancelButtonText: "🚩 Reportar",
                        confirmButtonColor: "#16a34a",
                        denyButtonColor: "#ef4444",
                    }).then(async (res) => {
                        let type = "";
                        if (res.isConfirmed) type = "positivo";
                        else if (res.isDenied) type = "sin_respuesta";
                        else if (res.isDismissed && res.dismiss === "cancel") type = "reporte";

                        if (type) {
                            await addDoc(collection(db, "feedback_contactos"), {
                                proId: idProfesional,
                                proNombre: proName,
                                tipo: type,
                                fecha: serverTimestamp()
                            });
                        }
                    });
                }, 2000);
            }


            // Report Profile Logic (Standardized)
            const btnReport = document.getElementById("btn-report-profile");
            const reportModal = document.getElementById("report-modal");
            const formReport = document.getElementById("form-report-profile");

            if(btnReport) {
                btnReport.addEventListener("click", (e) => {
                    e.preventDefault();
                    if(reportModal) reportModal.classList.remove("hidden");
                });
            }

            if(formReport) {
                formReport.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    console.log("🚀 [REPORT-DEBUG] Form submit triggered!");
                    console.trace("🚀 [REPORT-DEBUG] Trace:"); // See who called it
                    
                    const motivo = document.getElementById("report-motivo").value;
                    const desc = document.getElementById("report-desc").value;
                    
                    if (!motivo || !desc) {
                        return;
                    }

                    const btn = formReport.querySelector('button[type="submit"]');
                    const originalText = btn.textContent;
                    btn.disabled = true; btn.textContent = "Enviando...";

                    try {
                        // The 'motivo' and 'desc' variables are already declared above,
                        // so these declarations are redundant and removed.
                        
                        // FIXED: Collection name to match Admin Panel (denuncias)
                        await addDoc(collection(db, "denuncias"), {
                            profesionalId: idProfesional, 
                            profesionalNombre: profesionalJson.nombre || "Profesional", 
                            motivo: motivo,
                            descripcion: desc,
                            fecha: serverTimestamp(),
                            denuncianteUid: auth.currentUser ? auth.currentUser.uid : null, 
                            denuncianteEmail: auth.currentUser ? auth.currentUser.email : 'Anónimo'
                        });
                        
                        // Show Success Modal
                        showStatusModal('Reporte Enviado', 'Nuestro equipo de moderación revisará el caso a la brevedad.', 'success');
                        
                        // Close and reset
                        if(reportModal) reportModal.classList.add("hidden");
                        formReport.reset();

                    } catch(e) {
                         console.error("Error sending report:", e);
                         showStatusModal('Error', 'No se pudo enviar el reporte. Por favor intenta nuevamente.', 'error');
                    } finally {
                        btn.disabled = false; btn.textContent = originalText;
                    }
                });
            }

            // Helper: Show Status Modal
            const showStatusModal = (title, message, type = 'success') => {
                const modal = document.getElementById("status-modal");
                if(!modal) return;
                
                const iconMap = {
                    'success': '✅',
                    'error': '❌',
                    'info': 'ℹ️',
                    'warning': '⚠️'
                };

                const iconEl = document.getElementById("status-icon");
                const titleEl = document.getElementById("status-title");
                const msgEl = document.getElementById("status-message");

                if(iconEl) iconEl.innerHTML = iconMap[type] || '✨';
                if(titleEl) titleEl.textContent = title;
                if(msgEl) msgEl.textContent = message;

                modal.classList.remove("hidden");
            };

            // Favorites Logic (Fixed Auth Race Condition)
            const btnFav = document.getElementById("btn-toggle-fav");
            if(btnFav && idProfesional) {
                // Initialize state
                let isFav = false;
                
                onAuthStateChanged(auth, async (user) => {
                    // console.log("🚀 [FAV-DEBUG] Auth State Changed:", user ? `User: ${user.uid}` : "No User");
                    if(!user) {
                        // Reset if logged out
                        isFav = false;
                        updateFavIcon(false);
                        return; 
                    }

                    const favRef = doc(db, "favoritos", user.uid);
                    // console.log(`🚀 [FAV-DEBUG] Fetching doc: favoritos/${user.uid}`);

                    try {
                        // Only fetch now that we KNOW user is defined
                        const favSnap = await getDoc(favRef);
                        // console.log("🚀 [FAV-DEBUG] Fetch result:", favSnap.exists() ? "Exists" : "Not Found");
                        
                        if(favSnap.exists()) {
                            const list = favSnap.data().profesionales || [];
                            isFav = list.some(p => p.id === idProfesional);
                            updateFavIcon(isFav);
                        }
                    } catch(e) {
                         // Silent error for fetch
                         console.error("Error fetching favorites:", e);
                    }
                });
                
                // Helper to update UI
                function updateFavIcon(fav) {
                    const icon = btnFav.querySelector(".material-symbols-outlined");
                    if(!icon) return;
                    if(fav) {
                        icon.style.fontVariationSettings = "'FILL' 1";
                        btnFav.classList.add("text-red-500", "bg-red-50");
                        btnFav.classList.remove("text-slate-400", "bg-slate-50");
                    } else {
                        icon.style.fontVariationSettings = "'FILL' 0";
                        btnFav.classList.remove("text-red-500", "bg-red-50");
                        btnFav.classList.add("text-slate-400", "bg-slate-50");
                    }
                }

                btnFav.addEventListener("click", async () => {
                    const user = auth.currentUser;
                    if (!user) {
                         // Redirect to login or show alert
                         showStatusModal('Acceso Requerido', 'Debes iniciar sesión para guardar favoritos.', 'warning');
                         return;
                    }
                    
                    // Optimistic update
                    isFav = !isFav;
                    updateFavIcon(isFav);

                    try {
                         const favRef = doc(db, "favoritos", user.uid);
                         
                        if (isFav) {
                            await setDoc(favRef, {
                                profesionales: arrayUnion({
                                    id: idProfesional,
                                    nombre: profesionalJson.nombre || "Profesional",
                                    rubro: profesionalJson.rubro_principal || "",
                                    foto: profesionalJson.foto || "",
                                    zona: profesionalJson.zona || ""
                                })
                            }, { merge: true });
                        } else {
                            // Removing is trickier with arrayRemove if object differs, 
                            // need to read-modify-write for safety or ensure object exact match.
                            // For now, let's just toggle UI and fetch-update safely.
                            const currentSnap = await getDoc(favRef);
                            if(currentSnap.exists()) {
                                const currentList = currentSnap.data().profesionales || [];
                                const newList = currentList.filter(p => p.id !== idProfesional);
                                await updateDoc(favRef, { profesionales: newList });
                            }
                        }
                    } catch(e) {
                        console.error("Error updating favorite:", e);
                        // Revert on error
                        isFav = !isFav;
                        updateFavIcon(isFav);
                        showStatusModal('Error', 'No se pudo actualizar favoritos.', 'error');
                    }
                });
            }
        });
    </script>

    <style>
        /* Fix map */
        #mini-map {
            height: 200px;
            width: 100%;
            background: #f0f0f0;
            z-index: 1;
            min-height: 200px; /* Force height */
        }
        .leaflet-container {
            font-family: inherit;
        }

        /* Ensure modal overlay is above everything */
        #budget-modal, #report-modal {
            z-index: 9999;
        }
    </style>

    <!-- Modal de Reporte (Standardized) -->
    <div
        id="report-modal"
        class="fixed inset-0 bg-black/60 hidden items-center justify-center p-4 backdrop-blur-sm"
    >
        <div class="bg-white rounded-2xl w-full max-w-md relative shadow-2xl overflow-hidden animate-fade-in-up">
            <div class="bg-red-50 p-6 flex justify-between items-center border-b border-red-100">
                <div>
                    <h3 class="font-bold text-xl text-red-700">Reportar Perfil</h3>
                    <p class="text-xs text-red-500 mt-1">Ayúdanos a mantener segura la comunidad</p>
                </div>
                <button id="btn-close-report" class="text-red-400 hover:text-red-600 text-2xl font-bold" onclick="document.getElementById('report-modal').classList.add('hidden')">&times;</button>
            </div>
            
            <form id="form-report-profile" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Motivo</label>
                    <select id="report-motivo" required class="w-full p-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 bg-white">
                        <option value="">Seleccionar motivo...</option>
                        <option value="spam">Spam o Publicidad</option>
                        <option value="falso">Perfil Falso / Suplantación</option>
                        <option value="comportamiento">Comportamiento Inapropiado</option>
                        <option value="fraude">Intento de Estafa</option>
                        <option value="otro">Otro</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Detalles del caso</label>
                    <textarea 
                        id="report-desc" 
                        required 
                        rows="3" 
                        class="w-full p-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 resize-none"
                        placeholder="Describe brevemente lo sucedido..."
                    ></textarea>
                </div>

                <div class="pt-2 flex gap-3">
                    <button type="button" id="btn-cancel-report" class="flex-1 py-3 text-gray-500 font-bold hover:bg-gray-50 rounded-xl transition" onclick="document.getElementById('report-modal').classList.add('hidden')">Cancelar</button>
                    <button type="submit" class="flex-1 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition shadow-md">Enviar Reporte</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Status Messages (Success/Error) -->
    <div
        id="status-modal"
        class="fixed inset-0 bg-black/60 hidden items-center justify-center p-4 backdrop-blur-sm z-[10000]"
    >
        <div class="bg-white rounded-2xl w-full max-w-sm relative shadow-2xl overflow-hidden animate-fade-in-up p-6 text-center transform transition-all scale-100">
            <div id="status-icon" class="mb-4 text-5xl"></div>
            <h3 id="status-title" class="font-bold text-xl text-slate-900 mb-2"></h3>
            <p id="status-message" class="text-sm text-slate-500 mb-6 leading-relaxed"></p>
            
            <button 
                id="btn-close-status" 
                class="w-full py-3 bg-slate-900 text-white font-bold rounded-xl hover:bg-slate-800 transition shadow-md"
                onclick="document.getElementById('status-modal').classList.add('hidden')"
            >
                Entendido
            </button>
        </div>
    </div>

</Layout>
<script is:inline>
  // Script de respaldo y verificación inmediata
  async function registrarClickWhatsAppGlobal(uid) {
    console.log("🚀 [TRACK-DEBUG] Registrando click para:", uid);
    
    try {
      const response = await fetch('/api/track-click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid })
      });

      const data = await response.json();

      if (response.ok) {
        const display = document.getElementById('clicks-current');
        const progress = document.getElementById('clicks-progress');
        if (display) display.innerText = data.actual;
        if (progress) {
            const pct = Math.min((data.actual / 60) * 100, 100);
            progress.style.width = pct + "%";
        }
        console.log("✅ [TRACK-DEBUG] Nuevo valor:", data.actual);
        return true;
      }
      
      if (response.status === 403) {
        // @ts-ignore
        if (window.Swal) {
             window.Swal.fire({
                icon: 'error',
                title: 'Perfil en Pausa',
                text: 'Este profesional ha alcanzado su límite de 60 contactos gratuitos.',
                confirmButtonText: 'Ver Planes',
                confirmButtonColor: '#ea580c'
            }).then(r => { if(r.isConfirmed) window.location.href = "/planes" });
        } else {
            alert("Límite de 60 clicks alcanzado.");
            window.location.href = "/planes";
        }
        return false;
      }
    } catch (error) {
      console.error("❌ [TRACK-DEBUG] Error:", error);
      return true;
    }
  }
</script>

