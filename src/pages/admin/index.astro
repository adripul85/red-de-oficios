---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Panel de Operaciones - DeOficios">
    <section>
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center space-x-4">
                <div class="h-6 w-1 bg-[var(--accent-gold)] rounded-full"></div>
                <h2
                    class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-[0.25em]"
                >
                    Métricas Operativas Clave
                </h2>
            </div>
            <button
                id="btn-config-layout"
                class="text-[10px] font-bold text-[var(--text-secondary)] hover:text-[var(--accent-gold)] flex items-center uppercase tracking-widest border border-[var(--border-color)] px-3 py-1.5 rounded bg-white shadow-sm transition-all"
            >
                <span class="material-symbols-outlined !text-xs mr-2"
                    >settings</span
                >
                Configurar Diseño
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Profesionales Activos -->
            <div class="metric-card p-8 rounded-xl">
                <div class="flex justify-between items-start mb-6">
                    <p
                        class="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest"
                    >
                        Profesionales Activos
                    </p>
                    <span
                        class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[10px] font-bold border border-emerald-100"
                        >En línea</span
                    >
                </div>
                <div class="flex items-end justify-between">
                    <p
                        class="text-4xl font-light text-[var(--text-primary)]"
                        id="count-users"
                    >
                        ...
                    </p>
                    <p
                        class="text-[10px] font-medium text-[var(--text-secondary)] uppercase tracking-tighter opacity-70"
                    >
                        Prestadores Verificados
                    </p>
                </div>
            </div>

            <!-- Reportes Pendientes -->
            <div class="metric-card p-8 rounded-xl">
                <div class="flex justify-between items-start mb-6">
                    <p
                        class="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest"
                    >
                        Reportes Pendientes
                    </p>
                    <span
                        class="text-slate-500 bg-slate-50 px-2 py-0.5 rounded text-[10px] font-bold border border-slate-100"
                        >Estable</span
                    >
                </div>
                <div class="flex items-end justify-between">
                    <p
                        class="text-4xl font-light text-[var(--text-primary)]"
                        id="count-reports"
                    >
                        0
                    </p>
                    <p
                        class="text-[10px] font-medium text-[var(--text-secondary)] uppercase tracking-tighter opacity-70"
                    >
                        Acciones requeridas
                    </p>
                </div>
            </div>

            <!-- Balance Financiero -->
            <div
                class="metric-card p-8 rounded-xl border-l-4 gold-border"
                id="finance-card"
            >
                <div class="flex justify-between items-start mb-6">
                    <p
                        class="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest"
                    >
                        Balance Financiero
                    </p>
                    <span
                        class="text-[var(--accent-gold)] bg-orange-50/50 px-2 py-0.5 rounded text-[10px] font-bold border border-orange-100/50"
                        >Total histórico</span
                    >
                </div>
                <div class="flex items-end justify-between">
                    <p class="text-3xl font-bold accent-text" id="revenue">
                        $ 0
                    </p>
                    <p
                        class="text-[10px] font-medium text-[var(--text-secondary)] uppercase tracking-tighter opacity-70"
                    >
                        Ingresos totales
                    </p>
                </div>
            </div>

            <!-- Acción de añadir métrica -->
            <div
                id="btn-add-metric"
                class="metric-card p-8 rounded-xl bg-[var(--main-bg)] border-dashed border-2 flex flex-col items-center justify-center text-[var(--text-secondary)] hover:bg-white hover:border-[var(--accent-gold)] hover:text-[var(--accent-gold)] cursor-pointer transition-all"
            >
                <span class="material-symbols-outlined !text-3xl mb-3"
                    >add_circle</span
                >
                <span class="text-[10px] font-bold uppercase tracking-[0.2em]"
                    >Añadir Métrica</span
                >
            </div>
        </div>
    </section>

    <div class="section-separator"></div>

    <section>
        <div class="flex items-center space-x-4 mb-8">
            <div class="h-6 w-1 bg-[var(--accent-gold)] rounded-full"></div>
            <h2
                class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-[0.25em]"
            >
                Acciones Operativas Rápidas
            </h2>
        </div>

        <div
            class="bg-white border border-[var(--border-color)] rounded-xl shadow-lg overflow-hidden"
        >
            <div
                class="px-8 py-5 border-b border-[var(--border-color)] flex items-center justify-between bg-[var(--main-bg)]/30"
            >
                <h3
                    class="text-xs font-bold text-[var(--text-primary)] uppercase tracking-widest"
                >
                    Módulos del Sistema
                </h3>
                <span
                    class="text-[10px] text-[var(--text-secondary)] font-medium uppercase tracking-tighter"
                    >Enlaces de acceso directo</span
                >
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="new-table-head">
                        <tr>
                            <th
                                class="px-8 py-4 font-bold border-b border-[var(--border-color)]"
                                >Módulo</th
                            >
                            <th
                                class="px-8 py-4 font-bold border-b border-[var(--border-color)]"
                                >Descripción</th
                            >
                            <th
                                class="px-8 py-4 font-bold border-b border-[var(--border-color)]"
                                >Estado</th
                            >
                            <th
                                class="px-8 py-4 font-bold text-right border-b border-[var(--border-color)]"
                                >Enlace Directo</th
                            >
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        <!-- Newsletter -->
                        <tr
                            class="table-row-enhanced hover:bg-[var(--main-bg)]/50"
                        >
                            <td class="px-8 py-6 flex items-center space-x-4">
                                <div
                                    class="w-9 h-9 rounded bg-slate-100 flex items-center justify-center"
                                >
                                    <span
                                        class="material-symbols-outlined text-[var(--text-secondary)] !text-lg"
                                        >mail</span
                                    >
                                </div>
                                <span
                                    class="font-bold text-[var(--text-primary)] tracking-tight"
                                    >Newsletter</span
                                >
                            </td>
                            <td
                                class="px-8 py-6 text-[var(--text-secondary)] text-xs leading-relaxed max-w-xs"
                                >Gestionar suscriptores y campañas
                                automatizadas.</td
                            >
                            <td class="px-8 py-6">
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase tracking-widest"
                                    >Activo</span
                                >
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a
                                    class="text-[11px] font-bold accent-text hover:brightness-90 uppercase tracking-widest flex items-center justify-end group"
                                    href="/admin/newsletter"
                                >
                                    Abrir Herramienta <span
                                        class="material-symbols-outlined !text-xs ml-2 group-hover:translate-x-1 transition-transform"
                                        >arrow_forward</span
                                    >
                                </a>
                            </td>
                        </tr>

                        <!-- Profesionales -->
                        <tr
                            class="table-row-enhanced hover:bg-[var(--main-bg)]/50"
                        >
                            <td class="px-8 py-6 flex items-center space-x-4">
                                <div
                                    class="w-9 h-9 rounded bg-slate-100 flex items-center justify-center"
                                >
                                    <span
                                        class="material-symbols-outlined text-[var(--text-secondary)] !text-lg"
                                        >engineering</span
                                    >
                                </div>
                                <span
                                    class="font-bold text-[var(--text-primary)] tracking-tight"
                                    >Profesionales</span
                                >
                            </td>
                            <td
                                class="px-8 py-6 text-[var(--text-secondary)] text-xs leading-relaxed max-w-xs"
                                >Control de directorio y análisis de desempeño.</td
                            >
                            <td class="px-8 py-6">
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase tracking-widest"
                                    >Activo</span
                                >
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a
                                    class="text-[11px] font-bold accent-text hover:brightness-90 uppercase tracking-widest flex items-center justify-end group"
                                    href="/admin/usuarios"
                                >
                                    Ver Listado <span
                                        class="material-symbols-outlined !text-xs ml-2 group-hover:translate-x-1 transition-transform"
                                        >arrow_forward</span
                                    >
                                </a>
                            </td>
                        </tr>

                        <!-- Usuarios/Clientes -->
                        <tr
                            class="table-row-enhanced hover:bg-[var(--main-bg)]/50"
                        >
                            <td class="px-8 py-6 flex items-center space-x-4">
                                <div
                                    class="w-9 h-9 rounded bg-slate-100 flex items-center justify-center"
                                >
                                    <span
                                        class="material-symbols-outlined text-[var(--text-secondary)] !text-lg"
                                        >group</span
                                    >
                                </div>
                                <span
                                    class="font-bold text-[var(--text-primary)] tracking-tight"
                                    >Soporte Clientes</span
                                >
                            </td>
                            <td
                                class="px-8 py-6 text-[var(--text-secondary)] text-xs leading-relaxed max-w-xs"
                                >Gestión del ciclo de vida del usuario final.</td
                            >
                            <td class="px-8 py-6">
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase tracking-widest"
                                    >Activo</span
                                >
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a
                                    class="text-[11px] font-bold accent-text hover:brightness-90 uppercase tracking-widest flex items-center justify-end group"
                                    href="/admin/clientes"
                                >
                                    Gestionar <span
                                        class="material-symbols-outlined !text-xs ml-2 group-hover:translate-x-1 transition-transform"
                                        >arrow_forward</span
                                    >
                                </a>
                            </td>
                        </tr>

                        <!-- Denuncias -->
                        <tr
                            class="table-row-enhanced hover:bg-[var(--main-bg)]/50"
                        >
                            <td class="px-8 py-6 flex items-center space-x-4">
                                <div
                                    class="w-9 h-9 rounded bg-amber-50 flex items-center justify-center"
                                >
                                    <span
                                        class="material-symbols-outlined text-amber-600 !text-lg"
                                        >report</span
                                    >
                                </div>
                                <span
                                    class="font-bold text-amber-900 tracking-tight"
                                    >Infracciones</span
                                >
                            </td>
                            <td
                                class="px-8 py-6 text-[var(--text-secondary)] text-xs leading-relaxed max-w-xs"
                                >Moderación de contenido y cumplimiento de
                                protocolos.</td
                            >
                            <td class="px-8 py-6">
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-amber-100 text-amber-800 border border-amber-200 uppercase tracking-widest"
                                    >Revisión</span
                                >
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a
                                    class="text-[11px] font-bold accent-text hover:brightness-90 uppercase tracking-widest flex items-center justify-end group"
                                    href="/admin/denuncias"
                                >
                                    Moderar <span
                                        class="material-symbols-outlined !text-xs ml-2 group-hover:translate-x-1 transition-transform"
                                        >arrow_forward</span
                                    >
                                </a>
                            </td>
                        </tr>

                        <!-- Validaciones -->
                        <tr
                            class="table-row-enhanced hover:bg-[var(--main-bg)]/50"
                        >
                            <td class="px-8 py-6 flex items-center space-x-4">
                                <div
                                    class="w-9 h-9 rounded bg-slate-100 flex items-center justify-center"
                                >
                                    <span
                                        class="material-symbols-outlined text-[var(--text-secondary)] !text-lg"
                                        >verified</span
                                    >
                                </div>
                                <span
                                    class="font-bold text-[var(--text-primary)] tracking-tight"
                                    >Validaciones</span
                                >
                            </td>
                            <td
                                class="px-8 py-6 text-[var(--text-secondary)] text-xs leading-relaxed max-w-xs"
                                >Autenticación de credenciales y documentación
                                legal.</td
                            >
                            <td class="px-8 py-6">
                                <span
                                    class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-bold bg-slate-100 text-slate-600 border border-slate-200 uppercase tracking-widest"
                                    >En cola</span
                                >
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a
                                    class="text-[11px] font-bold accent-text hover:brightness-90 uppercase tracking-widest flex items-center justify-end group"
                                    href="/admin/validaciones"
                                >
                                    Procesar <span
                                        class="material-symbols-outlined !text-xs ml-2 group-hover:translate-x-1 transition-transform"
                                        >arrow_forward</span
                                    >
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <script>
        import { auth, db } from "../../firebase/client";
        import { onAuthStateChanged, signOut } from "firebase/auth";
        import {
            doc,
            getDoc,
            collection,
            getCountFromServer,
            getDocs,
            query,
            where,
            onSnapshot,
        } from "firebase/firestore";

        let listeners: (() => void)[] = [];

        function cleanup() {
            listeners.forEach((unsub) => unsub());
            listeners = [];
        }

        document.addEventListener("astro:page-load", () => {
            cleanup();
            onAuthStateChanged(auth, (u) => {
                if (u) initDashboard(u);
            });
        });

        document.addEventListener("astro:before-preparation", cleanup);

        async function initDashboard(user: any) {
            try {
                const snap = await getDoc(doc(db, "profesionales", user.uid));
                if (!snap.exists()) return;

                const data = snap.data();
                const rawRol = (data.rol || data.role || "")
                    .toString()
                    .toLowerCase()
                    .trim();

                // Admin only sections
                if (rawRol === "admin" || rawRol === "administrador") {
                    const financeCard = document.getElementById("finance-card");
                    if (financeCard) financeCard.classList.remove("hidden");
                    if (financeCard) financeCard.classList.add("flex");
                }

                // Stats Elements
                const countUsers = document.getElementById("count-users");
                const countReports = document.getElementById("count-reports");
                const revenueEl = document.getElementById("revenue");

                // 1. Initial Static Count (Professionals)
                getCountFromServer(collection(db, "profesionales"))
                    .then((s) => {
                        if (countUsers)
                            countUsers.textContent = s.data().count.toString();
                    })
                    .catch((e) => console.warn("Error count users", e));

                // 2. Real-time Reporting Count
                const unsubReports = onSnapshot(
                    collection(db, "denuncias"),
                    (snap) => {
                        if (countReports)
                            countReports.textContent = snap.size.toString();
                    },
                );
                listeners.push(unsubReports);

                // 3. Revenue calculation
                const qRev = query(
                    collection(db, "pagos_historial"),
                    where("estado", "==", "approved"),
                );
                getDocs(qRev).then((snapRev) => {
                    let total = 0;
                    snapRev.forEach(
                        (d) => (total += Number(d.data().monto) || 0),
                    );
                    if (revenueEl)
                        revenueEl.textContent = `$ ${total.toLocaleString("es-AR")}`;
                });

                // Dashboard Actions
                const btnConfig = document.getElementById("btn-config-layout");
                const btnAdd = document.getElementById("btn-add-metric");

                if (btnConfig) {
                    btnConfig.addEventListener("click", () => {
                        window.location.href = "/admin/configuracion";
                    });
                }

                if (btnAdd) {
                    btnAdd.addEventListener("click", () => {
                        alert(
                            "🛠️ La personalización de métricas estará disponible próximamente en el Centro de Operaciones.",
                        );
                    });
                }
            } catch (e) {
                console.error("Dashboard Init Error (Client):", e);
            }
        }
    </script>
</LayoutAdmin>
