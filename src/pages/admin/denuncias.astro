---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Moderación - Denuncias de Usuarios">
  <main class="min-h-screen bg-slate-50 py-12 px-4 shadow-inner">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between mb-10 gap-6 text-slate-900">
        <div>
          <h1 class="text-4xl font-black text-slate-900 tracking-tight flex items-center gap-3">
             <span class="text-3xl">🚨</span> Centro de Moderación
          </h1>
          <p class="text-slate-500 font-medium mt-1">Gestiona reportes e infracciones de la comunidad</p>
        </div>
        <a href="/admin" class="w-full md:w-auto px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm flex items-center justify-center gap-2">
          ⬅ Volver al Inicio
        </a>
      </div>

      <div id="reports-container" class="space-y-6">
          <div class="flex items-center justify-center py-20">
              <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600"></div>
          </div>
      </div>
    </div>
  </main>
</Layout>

<script>
    import { auth, db } from '../../firebase/client';
    import { collection, getDocs, deleteDoc, doc, onSnapshot } from 'firebase/firestore';
    import { onAuthStateChanged } from 'firebase/auth';

    const container = document.getElementById('reports-container');

    document.addEventListener("astro:page-load", () => {
        onAuthStateChanged(auth, (user) => {
            if (user) {
                // Verify if it's an admin (optional but good practice as secondary check)
                startModerationListener();
            } else {
                window.location.href = "/ingresar";
            }
        });
    });

    function startModerationListener() {
        if (!container) return;

        // Using onSnapshot for real-time and client-side auth context
        onSnapshot(collection(db, "denuncias"), (snap) => {
            if (snap.empty) {
                renderEmpty();
                return;
            }

            const reportes = snap.docs.map(d => ({ id: d.id, ...d.data() }))
                .sort((a:any, b:any) => {
                    const timeA = a.fecha?.seconds || 0;
                    const timeB = b.fecha?.seconds || 0;
                    return timeB - timeA;
                });
            
            renderReports(reportes);
        }, (err) => {
            console.error("Moderation Listener Error:", err);
            container.innerHTML = `
                <div class="bg-red-50 border border-red-100 p-8 rounded-3xl text-center">
                    <p class="text-red-600 font-bold">Error de Acceso: No tienes permisos para ver esta sección.</p>
                </div>
            `;
        });
    }

    function renderEmpty() {
        container.innerHTML = `
            <div class="bg-emerald-50 border border-emerald-100 p-12 text-center rounded-3xl shadow-sm">
                <div class="text-5xl mb-4">✅</div>
                <h3 class="text-xl font-bold text-emerald-800">Todo bajo control</h3>
                <p class="text-emerald-600 mt-2 font-medium">No hay denuncias pendientes en este momento.</p>
            </div>
        `;
    }

    function renderReports(reportes) {
        container.innerHTML = `
            <div class="grid gap-6">
                ${reportes.map(r => `
                    <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
                        <div class="absolute top-0 left-0 w-1.5 h-full bg-red-500"></div>
                        
                        <div class="flex flex-col md:flex-row justify-between items-start gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-3">
                                    <span class="px-3 py-1 bg-red-50 text-red-600 text-[10px] font-black uppercase rounded-full">Reporte Nuevo</span>
                                    <span class="text-slate-400 text-xs font-semibold uppercase tracking-widest">
                                        ID: ${r.id.slice(-6).toUpperCase()}
                                    </span>
                                </div>

                                <h3 class="text-lg font-bold text-slate-800 mb-1">
                                    Denuncia contra: 
                                    <a href="/perfil?id=${r.profesionalId}" class="text-indigo-600 hover:underline">
                                        ${r.profesionalNombre || 'Ver Perfil'}
                                    </a>
                                </h3>
                                
                                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 mt-4">
                                    <p class="text-slate-500 text-[10px] font-black uppercase tracking-widest mb-2 opacity-60">Motivo y Detalle</p>
                                    <p class="text-slate-700 font-black text-sm mb-1">${r.motivo || 'No especificado'}</p>
                                    <p class="text-slate-600 text-sm leading-relaxed italic font-medium">"${r.descripcion || 'Sin descripción adicional'}"</p>
                                </div>

                                <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[10px] text-slate-400 font-black uppercase tracking-widest">
                                    <span class="flex items-center gap-1">👤 ${r.denuncianteEmail || 'Anónimo'}</span>
                                    <span class="flex items-center gap-1">📅 ${r.fecha?.seconds ? new Date(r.fecha.seconds * 1000).toLocaleString('es-AR') : 'Recientemente'}</span>
                                    ${r.denuncianteUid ? `<span class="opacity-50">UID: ${r.denuncianteUid.slice(0,8)}...</span>` : ''}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 self-end md:self-start pt-4 md:pt-0">
                                <button 
                                    data-id="${r.id}"
                                    class="btn-archivar px-6 py-3 bg-slate-100 text-slate-600 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-950 hover:text-white transition-all shadow-sm"
                                >
                                    Archivar
                                </button>
                                <button 
                                    data-id="${r.id}"
                                    class="btn-eliminar px-6 py-3 bg-red-50 text-red-600 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-red-600 hover:text-white transition-all shadow-sm"
                                >
                                    Borrar
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;

        // Attach listeners
        container.querySelectorAll('.btn-archivar').forEach(btn => {
            btn.addEventListener('click', () => handleAction(btn.getAttribute('data-id'), 'archive'));
        });
        container.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', () => handleAction(btn.getAttribute('data-id'), 'delete'));
        });
    }

    async function handleAction(id, type) {
        const actionText = type === 'archive' ? 'archivar' : 'borrar definitivamente';
        if (!confirm(`¿Estás seguro de que deseas ${actionText} este reporte?`)) return;

        try {
            await deleteDoc(doc(db, "denuncias", id));
            // No reload needed as we have onSnapshot
        } catch (e) {
            alert("Error al procesar la acción.");
        }
    }
</script>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    #reports-container { animation: fadeIn 0.5s ease-out; }
</style>
