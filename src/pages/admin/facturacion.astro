---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
import { dbAdmin } from "../../firebase/admin";
import VerifiedIcon from "../../components/ui/VerifiedIcon.astro";

// 1. Traemos los pagos "aprobados" desde Firestore
const pagosRef = dbAdmin.collection("pagos");
const snapshot = await pagosRef
    .where("status", "==", "approved")
    .orderBy("date_created", "desc")
    .limit(100)
    .get();

const ventas = snapshot.docs.map((doc) => {
    const data = doc.data();
    return {
        id: doc.id,
        fecha: data.date_created
            ? new Date(data.date_created).toLocaleDateString("es-AR")
            : "Sin fecha",
        monto: data.transaction_amount || 0,
        email: data.payer?.email || "Sin email",
        facturado: data.facturado || false,
        description: data.description || "Suscripción Plan",
        fecha_facturacion: data.fecha_facturacion || null,
    };
});

// Cálculos rápidos
const totalPendienteFacturar = ventas
    .filter((v) => !v.facturado)
    .reduce((acc, curr) => acc + curr.monto, 0);
---

<LayoutAdmin title="Gestión de Facturación | ARCA">
    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">
                Facturación (ARCA)
            </h1>
            <p class="text-slate-500 text-sm font-medium">
                Gestiona los comprobantes electrónicos de tus ventas.
            </p>
        </div>
        <div
            class="bg-orange-100 text-orange-800 px-6 py-3 rounded-2xl font-black shadow-sm border border-orange-200"
        >
            <span class="text-xs uppercase block opacity-70">Pendiente</span>
            <span class="text-xl"
                >${totalPendienteFacturar.toLocaleString("es-AR")}</span
            >
        </div>
    </div>

    <!-- Guía de Uso Rápida -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div
            class="bg-blue-50 border border-blue-100 p-5 rounded-3xl shadow-sm"
        >
            <div class="flex items-center gap-3 mb-3 text-blue-800">
                <span class="material-symbols-outlined !text-2xl">info</span>
                <h3 class="font-black text-xs uppercase tracking-widest">
                    Paso 1: Portal ARCA
                </h3>
            </div>
            <p class="text-xs text-blue-700 leading-relaxed font-medium">
                Haz clic en <strong>"Ir a ARCA"</strong> en la venta que quieras facturar.
                Ingresa con tu CUIT y Clave Fiscal al servicio de <i
                    >"Comprobantes en Línea"</i
                >.
            </p>
        </div>
        <div
            class="bg-indigo-50 border border-indigo-100 p-5 rounded-3xl shadow-sm"
        >
            <div class="flex items-center gap-3 mb-3 text-indigo-800">
                <span class="material-symbols-outlined !text-2xl"
                    >edit_document</span
                >
                <h3 class="font-black text-xs uppercase tracking-widest">
                    Paso 2: Generar Manual
                </h3>
            </div>
            <p class="text-xs text-indigo-700 leading-relaxed font-medium">
                Genera la factura (A, B o C según corresponda). Usa el email del
                cliente y el monto que figura en la tabla. Descarga el PDF para
                enviárselo luego.
            </p>
        </div>
        <div
            class="bg-green-50 border border-green-100 p-5 rounded-3xl shadow-sm"
        >
            <div class="flex items-center gap-3 mb-3 text-green-800">
                <span class="material-symbols-outlined !text-2xl"
                    >check_circle</span
                >
                <h3 class="font-black text-xs uppercase tracking-widest">
                    Paso 3: Confirmar
                </h3>
            </div>
            <p class="text-xs text-green-700 leading-relaxed font-medium">
                Una vez emitida, vuelve aquí y presiona <strong
                    >"Confirmar"</strong
                >. Esto marcará la venta como facturada en el sistema para tu
                control interno.
            </p>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Cliente / Pago</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {
                    ventas.map((venta) => (
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="text-sm text-slate-500 font-medium">
                                {venta.fecha}
                            </td>
                            <td>
                                <div class="font-bold text-slate-700">
                                    {venta.email}
                                </div>
                                <div class="text-[10px] font-mono text-slate-400">
                                    ID: {venta.id.slice(0, 12)}...
                                </div>
                            </td>
                            <td class="text-xs text-slate-600 font-medium">
                                {venta.description}
                            </td>
                            <td class="font-black text-slate-800">
                                ${venta.monto.toLocaleString("es-AR")}
                            </td>
                            <td>
                                {venta.facturado ? (
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-700 text-[10px] font-black uppercase tracking-wider border border-green-200">
                                        <VerifiedIcon class="w-3.5 h-3.5" />{" "}
                                        Facturado
                                    </span>
                                ) : (
                                    <span class="inline-flex px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-[10px] font-black uppercase tracking-wider border border-amber-200">
                                        ⏳ Pendiente
                                    </span>
                                )}
                            </td>
                            <td>
                                <div class="flex items-center gap-3">
                                    {!venta.facturado && (
                                        <>
                                            <a
                                                href="https://auth.afip.gob.ar/contribuyente_/login.xhtml"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="bg-blue-600 text-white px-4 py-1.5 rounded-xl text-xs font-black hover:bg-blue-700 transition-all shadow-sm hover:shadow-md active:scale-95"
                                            >
                                                Ir a ARCA
                                            </a>
                                            <button
                                                onclick={`marcarComoFacturado('${venta.id}')`}
                                                class="text-orange-600 hover:text-orange-800 text-xs font-black uppercase tracking-tighter hover:underline"
                                            >
                                                Confirmar
                                            </button>
                                        </>
                                    )}
                                    {venta.facturado && (
                                        <span class="text-[10px] text-slate-400 font-bold italic">
                                            Listo el{" "}
                                            {venta.fecha_facturacion
                                                ? new Date(
                                                      venta.fecha_facturacion.toDate(),
                                                  ).toLocaleDateString()
                                                : "-"}
                                        </span>
                                    )}
                                </div>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>

        {
            ventas.length === 0 && (
                <div class="p-20 text-center text-slate-400 bg-white rounded-3xl border-2 border-dashed border-slate-100">
                    No hay ventas registradas aún.
                </div>
            )
        }
    </div>
</LayoutAdmin>

<script is:inline>
    async function marcarComoFacturado(idPago) {
        if (
            !confirm(
                "¿Ya generaste el comprobante en la web de ARCA para este pago?",
            )
        )
            return;

        try {
            // Mostrar loading simple
            const btn = event.target;
            const originalText = btn.innerText;
            btn.innerText = "⏳...";
            btn.disabled = true;

            const res = await fetch("/api/admin/marcar-facturado", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: idPago }),
            });

            if (res.ok) {
                window.location.reload();
            } else {
                alert("Error al actualizar");
                btn.innerText = originalText;
                btn.disabled = false;
            }
        } catch (error) {
            console.error(error);
            alert("Error de conexión");
        }
    }
</script>
