---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
import { db } from "../../firebase/client";
import { collection, getDocs, orderBy, query } from "firebase/firestore";

// TRAER TODOS LOS USUARIOS (Server-side initial load)
const users = [];
try {
    const q = query(collection(db, "profesionales"), orderBy("nombre"));
    const snapshot = await getDocs(q);
    snapshot.forEach((doc) => {
        users.push({ id: doc.id, ...doc.data() });
    });
} catch (e) {
    console.error("Error fetching users server-side:", e);
}
---

<LayoutAdmin title="Gestión de Profesionales - Admin">
    <div
        class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4"
    >
        <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight">
                Gestión de Profesionales 👥
            </h1>
            <p class="text-slate-500 font-medium">
                Total: <span class="text-blue-600 font-black"
                    >{users.length}</span
                > registrados
            </p>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto">
            <div class="relative flex-1 md:flex-none">
                <span
                    class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
                    >🔍</span
                >
                <input
                    type="text"
                    id="searchUser"
                    placeholder="Buscar por nombre o email..."
                    class="w-full md:w-72 pl-10 pr-4 py-3 bg-white border border-slate-100 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-blue-500 outline-none shadow-sm transition-all"
                />
            </div>
        </div>
    </div>

    <div
        class="bg-white rounded-[2rem] shadow-sm border border-slate-50 overflow-hidden"
    >
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="usersTable">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-50">
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest"
                            >Perfil</th
                        >
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest"
                            >Datos / Rubro</th
                        >
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center"
                            >Métricas</th
                        >
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest"
                            >Estado</th
                        >
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest"
                            >Plan</th
                        >
                        <th
                            class="px-6 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right"
                            >Acciones</th
                        >
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {
                        users.map((u) => (
                            <tr class="user-row hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-4">
                                        <div class="relative">
                                            {u.foto ? (
                                                <img
                                                    src={u.foto}
                                                    class="w-12 h-12 rounded-2xl object-cover shadow-sm border-2 border-white"
                                                />
                                            ) : (
                                                <div class="w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center text-xl shadow-inner">
                                                    👤
                                                </div>
                                            )}
                                            {(u.verificado ||
                                                u.dni_verificado) && (
                                                <span class="absolute -top-1 -right-1 bg-blue-500 text-white text-[8px] p-0.5 rounded-full ring-2 ring-white">
                                                    ✅
                                                </span>
                                            )}
                                            {u.antecedentes_verificados && (
                                                <span
                                                    class="absolute -bottom-1 -right-1 bg-amber-400 text-white text-[8px] p-0.5 rounded-full ring-2 ring-white"
                                                    title="Nivel Oro"
                                                >
                                                    ⭐
                                                </span>
                                            )}
                                        </div>
                                        <div>
                                            <p class="font-black text-slate-800 text-sm leading-tight u-name">
                                                {u.nombre}
                                            </p>
                                            <p
                                                class="text-xs text-slate-400 font-bold italic truncate max-w-[150px] u-email"
                                                title={u.email}
                                            >
                                                {u.email || "Sin email"}
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <p class="text-xs font-black text-slate-700 uppercase tracking-tight">
                                        {u.rubro_principal ||
                                            u.categoria ||
                                            "Sin rubro"}
                                    </p>
                                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5 flex items-center gap-1">
                                        <span class="grayscale opacity-50">
                                            📍
                                        </span>{" "}
                                        {u.zona || "Global"}
                                    </p>
                                </td>
                                <td class="px-6 py-5 text-center">
                                    <div
                                        class="inline-flex flex-col items-center px-3 py-1 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100/50"
                                        title="Clicks WhatsApp"
                                    >
                                        <span class="text-[10px] font-black uppercase leading-none mb-1">
                                            WA
                                        </span>
                                        <span class="text-sm font-black leading-none">
                                            {u.contactos_whatsapp || 0}
                                        </span>
                                    </div>
                                </td>
                                <td
                                    class="px-6 py-5 whitespace-nowrap"
                                    id={`status-${u.id}`}
                                >
                                    <div class="flex flex-col gap-1">
                                        {u.verificado || u.dni_verificado ? (
                                            <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[9px] font-black uppercase rounded border border-blue-100 w-fit">
                                                Identidad OK
                                            </span>
                                        ) : (
                                            <span class="px-2 py-0.5 bg-slate-100 text-slate-400 text-[9px] font-black uppercase rounded w-fit">
                                                ID Pendiente
                                            </span>
                                        )}
                                        {u.antecedentes_verificados && (
                                            <span class="px-2 py-0.5 bg-amber-50 text-amber-600 text-[9px] font-black uppercase rounded border border-amber-100 w-fit shadow-inner">
                                                Nivel Oro
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td class="px-6 py-5" id={`plan-${u.id}`}>
                                    {u.plan &&
                                    (u.plan === "experto" ||
                                        u.plan === "semestral" ||
                                        u.plan === "mensual") ? (
                                        <span class="px-3 py-1 bg-amber-50 text-amber-600 text-[10px] font-black uppercase rounded-lg border border-amber-100 shadow-sm">
                                            Diamond
                                        </span>
                                    ) : (
                                        <span class="px-3 py-1 bg-slate-50 text-slate-400 text-[10px] font-black uppercase rounded-lg border border-slate-100">
                                            Free
                                        </span>
                                    )}
                                </td>
                                <td class="px-6 py-5 text-right">
                                    <button
                                        class="btn-manage px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all shadow-sm active:scale-95"
                                        data-user={JSON.stringify(u)}
                                    >
                                        Gestionar
                                    </button>
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- MODAL GESTION -->
    <dialog
        id="userModal"
        class="bg-white rounded-[2.5rem] shadow-2xl p-0 w-[95%] max-w-2xl overflow-hidden backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm border border-slate-100"
    >
        <div class="relative">
            <button
                id="btn-close-modal"
                class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-2xl bg-slate-50 text-slate-400 hover:text-slate-800 transition-all font-black text-xl z-20"
                >&times;</button
            >

            <div class="p-8 pb-0 flex items-center gap-6">
                <div
                    id="m-foto-container"
                    class="w-20 h-20 rounded-3xl bg-slate-100 flex items-center justify-center text-3xl shadow-inner border shadow-blue-50"
                >
                    👤
                </div>
                <div>
                    <h2
                        id="m-nombre"
                        class="text-2xl font-black text-slate-900 tracking-tight leading-none mb-2"
                    >
                        Cargando...
                    </h2>
                    <p
                        id="m-id"
                        class="text-[10px] font-black text-slate-400 uppercase tracking-widest"
                    >
                        ID: ...
                    </p>
                </div>
            </div>

            <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Columna Izquierda: Datos y Verificacion -->
                <div class="space-y-6">
                    <section>
                        <h3
                            class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2"
                        >
                            <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"
                            ></span> Información Técnica
                        </h3>
                        <div class="space-y-3">
                            <div
                                class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl"
                            >
                                <span class="text-xs font-bold text-slate-500"
                                    >Documento DNI</span
                                >
                                <span
                                    id="m-dni"
                                    class="text-xs font-black text-slate-800"
                                    >-</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl"
                            >
                                <span class="text-xs font-bold text-slate-500"
                                    >CUIT / CUIL</span
                                >
                                <span
                                    id="m-cuit"
                                    class="text-xs font-black text-slate-800"
                                    >-</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl"
                            >
                                <span class="text-xs font-bold text-slate-500"
                                    >Estado Oro</span
                                >
                                <strong
                                    id="m-oro-status"
                                    class="text-[10px] font-black uppercase text-amber-600"
                                    >-</strong
                                >
                            </div>
                            <div
                                class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl"
                            >
                                <span class="text-xs font-bold text-slate-500"
                                    >Rol Sistema</span
                                >
                                <strong
                                    id="m-rol-display"
                                    class="text-[10px] font-black uppercase text-blue-600"
                                    >PROFESIONAL</strong
                                >
                            </div>
                        </div>
                    </section>

                    <section>
                        <h3
                            class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2"
                        >
                            <span
                                class="w-1.5 h-1.5 bg-emerald-500 rounded-full"
                            ></span> Sello de Confianza
                        </h3>
                        <div class="flex gap-2">
                            <button
                                id="btn-verify"
                                class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white text-[10px] font-black uppercase py-4 rounded-2xl transition-all shadow-lg shadow-emerald-100"
                                >✅ Vincular</button
                            >
                            <button
                                id="btn-unverify"
                                class="px-6 bg-slate-100 hover:bg-slate-200 text-slate-400 hover:text-slate-600 py-4 rounded-2xl transition-all text-sm font-black"
                                >❌ Quitar</button
                            >
                        </div>
                        <a
                            id="m-cert-link"
                            href="#"
                            target="_blank"
                            class="block text-center mt-3 text-[10px] font-black uppercase text-blue-600 hover:underline hidden"
                            >Ver Documento Adjunto 📄</a
                        >
                    </section>
                </div>

                <!-- Columna Derecha: Roles y Membresia -->
                <div class="space-y-6">
                    <section>
                        <h3
                            class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2"
                        >
                            <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"
                            ></span> Cambiar Rol
                        </h3>
                        <div class="flex gap-2">
                            <select
                                id="m-rol-select"
                                class="flex-1 bg-slate-50 border border-slate-100 rounded-2xl px-4 py-3 text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-500 appearance-none"
                            >
                                <option value="profesional">Profesional</option>
                                <option value="moderador">Moderador</option>
                                <option value="admin">Administrador</option>
                            </select>
                            <button
                                id="btn-save-rol"
                                class="w-12 h-12 bg-indigo-600 hover:bg-indigo-700 text-white rounded-2xl flex items-center justify-center transition-all shadow-lg shadow-indigo-100"
                                >💾</button
                            >
                        </div>
                    </section>

                    <section>
                        <h3
                            class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2"
                        >
                            <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"
                            ></span> Forzar Membresía
                        </h3>
                        <div class="flex gap-2">
                            <select
                                id="m-plan-select"
                                class="flex-1 bg-slate-50 border border-slate-100 rounded-2xl px-4 py-3 text-sm font-bold outline-none focus:ring-2 focus:ring-amber-500 appearance-none"
                            >
                                <option value="gratuito">Plan Gratuito</option>
                                <option value="mensual">Mensual Diamond</option>
                                <option value="semestral"
                                    >Semestral Diamond</option
                                >
                                <option value="experto">Plan Experto</option>
                            </select>
                            <button
                                id="btn-save-plan"
                                class="w-12 h-12 bg-amber-500 hover:bg-amber-600 text-white rounded-2xl flex items-center justify-center transition-all shadow-lg shadow-amber-100"
                                >💎</button
                            >
                        </div>
                    </section>

                    <section class="pt-4">
                        <button
                            id="btn-delete-user"
                            class="w-full bg-rose-50 hover:bg-rose-100 text-rose-600 text-[10px] font-black uppercase py-4 rounded-2xl border border-rose-100 transition-all"
                            >🗑️ Eliminar Definitivamente</button
                        >
                    </section>
                </div>
            </div>
        </div>
    </dialog>
</LayoutAdmin>

<script>
    import { db, auth } from "../../firebase/client";
    import { doc, updateDoc, getDoc, deleteDoc } from "firebase/firestore";
    import { onAuthStateChanged } from "firebase/auth";

    document.addEventListener("astro:page-load", () => {
        // 1. BUSCADOR
        const searchInput = document.getElementById("searchUser");
        searchInput?.addEventListener("keyup", (e) => {
            // @ts-ignore
            const term = e.target.value.toLowerCase();
            document.querySelectorAll(".user-row").forEach((row) => {
                const nameNode = row.querySelector(".u-name");
                const emailNode = row.querySelector(".u-email");

                if (nameNode && emailNode) {
                    const name = nameNode.textContent?.toLowerCase() || "";
                    const email = emailNode.textContent?.toLowerCase() || "";

                    // @ts-ignore
                    row.style.display =
                        name.includes(term) || email.includes(term)
                            ? ""
                            : "none";
                }
            });
        });

        // 2. LÓGICA DEL MODAL
        const modal = document.getElementById("userModal") as HTMLDialogElement;
        const closeBtn = document.getElementById("btn-close-modal");
        let currentUserId = null;

        if (!modal) return;

        // Cerrar modal
        closeBtn?.addEventListener("click", () => modal.close());
        modal.addEventListener("click", (e) => {
            if (e.target === modal) modal.close();
        });

        // 3. Abrir modal
        document.querySelectorAll(".btn-manage").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                // @ts-ignore
                const userData = JSON.parse(e.currentTarget.dataset.user);
                openModal(userData);
            });
        });

        function openModal(u) {
            currentUserId = u.id;

            const mNombre = document.getElementById("m-nombre");
            const mId = document.getElementById("m-id");
            const mDni = document.getElementById("m-dni");
            const mCuit = document.getElementById("m-cuit");
            const mRolDisplay = document.getElementById("m-rol-display");
            const mFotoContainer = document.getElementById("m-foto-container");
            const mCertLink = document.getElementById("m-cert-link");
            const mPlanSelect = document.getElementById(
                "m-plan-select",
            ) as HTMLSelectElement;
            const mRolSelect = document.getElementById(
                "m-rol-select",
            ) as HTMLSelectElement;

            if (mNombre) mNombre.textContent = u.nombre;
            if (mId) mId.textContent = "ID: " + u.id;
            if (mDni) mDni.textContent = u.dni || "No cargado";
            if (mCuit) mCuit.textContent = u.cuit || "No cargado";

            const oroEl = document.getElementById("m-oro-status");
            if (oroEl) {
                oroEl.textContent = u.antecedentes_verificados
                    ? "NIVEL ORO"
                    : "PENDIENTE/NO SUBIDO";
                oroEl.className = u.antecedentes_verificados
                    ? "text-[10px] font-black uppercase text-amber-600"
                    : "text-[10px] font-black uppercase text-slate-400";
            }

            if (mFotoContainer) {
                if (u.foto) {
                    mFotoContainer.innerHTML = `<img src="${u.foto}" class="w-full h-full object-cover rounded-3xl">`;
                } else {
                    mFotoContainer.innerHTML = "👤";
                }
            }

            // Certificado
            if (mCertLink) {
                if (u.certificado_url) {
                    // @ts-ignore
                    mCertLink.href = u.certificado_url;
                    mCertLink.classList.remove("hidden");
                } else {
                    mCertLink.classList.add("hidden");
                }
            }

            // Planes y Roles
            if (mPlanSelect) mPlanSelect.value = u.plan || "gratuito";

            const currentRol = u.rol || "profesional";
            if (mRolDisplay) mRolDisplay.textContent = currentRol.toUpperCase();
            if (mRolSelect) mRolSelect.value = currentRol;

            modal.showModal();
        }

        // 4. ACCIONES
        document
            .getElementById("btn-verify")
            ?.addEventListener("click", async () => {
                if (
                    !currentUserId ||
                    !confirm("¿Confirmas que el documento es válido?")
                )
                    return;
                try {
                    await updateDoc(doc(db, "profesionales", currentUserId), {
                        verificado: true,
                    });
                    alert("¡Usuario Verificado! ✅");
                    window.location.reload();
                } catch (e) {
                    alert("Error: " + e.message);
                }
            });

        document
            .getElementById("btn-unverify")
            ?.addEventListener("click", async () => {
                if (!currentUserId || !confirm("¿Quitar verificación?")) return;
                try {
                    await updateDoc(doc(db, "profesionales", currentUserId), {
                        verificado: false,
                    });
                    alert("Verificación revocada.");
                    window.location.reload();
                } catch (e) {
                    alert("Error: " + e.message);
                }
            });

        document
            .getElementById("btn-save-rol")
            ?.addEventListener("click", async () => {
                const select = document.getElementById(
                    "m-rol-select",
                ) as HTMLSelectElement;
                const nuevoRol = select?.value;
                if (!currentUserId || !nuevoRol) return;

                if (confirm(`¿Cambiar rol a ${nuevoRol.toUpperCase()}?`)) {
                    try {
                        await updateDoc(
                            doc(db, "profesionales", currentUserId),
                            { rol: nuevoRol },
                        );
                        alert("Rol actualizado.");
                        window.location.reload();
                    } catch (e) {
                        alert("Error: " + e.message);
                    }
                }
            });

        document
            .getElementById("btn-save-plan")
            ?.addEventListener("click", async () => {
                const select = document.getElementById(
                    "m-plan-select",
                ) as HTMLSelectElement;
                const nuevoPlan = select?.value;
                if (!currentUserId || !nuevoPlan) return;

                try {
                    await updateDoc(doc(db, "profesionales", currentUserId), {
                        plan: nuevoPlan,
                    });
                    alert(`Plan actualizado a: ${nuevoPlan.toUpperCase()}`);
                    window.location.reload();
                } catch (e) {
                    alert("Error: " + e.message);
                }
            });

        document
            .getElementById("btn-delete-user")
            ?.addEventListener("click", async () => {
                if (!currentUserId) return;
                if (
                    confirm(
                        "⚠ PELIGRO: Esto borrará al usuario de la base de datos permanentemente.",
                    )
                ) {
                    try {
                        await deleteDoc(
                            doc(db, "profesionales", currentUserId),
                        );
                        alert("Usuario eliminado.");
                        window.location.reload();
                    } catch (e) {
                        alert("Error: " + e.message);
                    }
                }
            });
    });
</script>
