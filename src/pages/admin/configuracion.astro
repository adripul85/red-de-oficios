---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Configuración del Sistema ⚙️">
    <header class="mb-10">
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">
            Configuración del Sistema ⚙️
        </h1>
        <p class="text-slate-500 font-medium mt-1">
            Gestión de giftcards, precios de planes y parámetros globales
        </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Giftcard Card -->
        <div
            class="bg-white rounded-[2.5rem] shadow-sm border border-slate-50 overflow-hidden flex flex-col"
        >
            <header class="p-8 border-b border-slate-50 bg-purple-50/30">
                <h3
                    class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2"
                >
                    <span class="text-2xl">🎁</span> Gestión de Giftcard
                </h3>
                <p
                    class="text-xs text-slate-500 font-bold mt-1 uppercase tracking-widest"
                >
                    Cupones y promociones premium
                </p>
            </header>

            <form id="form-giftcard" class="p-8 space-y-6 flex-1">
                <div>
                    <label
                        class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                        >Código Promocional</label
                    >
                    <input
                        type="text"
                        id="giftcard-code"
                        placeholder="Ej: VERANO2026"
                        class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-black uppercase tracking-widest focus:ring-2 focus:ring-purple-500 outline-none transition-all"
                        required
                    />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                            >Duración (días)</label
                        >
                        <input
                            type="number"
                            id="giftcard-duration"
                            placeholder="60"
                            min="1"
                            class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-bold focus:ring-2 focus:ring-purple-500 outline-none transition-all"
                            required
                        />
                    </div>
                    <div>
                        <label
                            class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                            >Plan Otorgado</label
                        >
                        <select
                            id="giftcard-plan"
                            class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-bold focus:ring-2 focus:ring-purple-500 outline-none transition-all"
                            required
                        >
                            <option value="mensual">Plan Mensual</option>
                            <option value="experto">Plan Experto</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label
                        class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                        >Límite de Usos (opcional)</label
                    >
                    <input
                        type="number"
                        id="giftcard-max-uses"
                        placeholder="Ilimitado si se deja vacío"
                        min="1"
                        class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-bold focus:ring-2 focus:ring-purple-500 outline-none transition-all"
                    />
                </div>

                <div
                    class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-100"
                >
                    <input
                        type="checkbox"
                        id="giftcard-active"
                        class="w-6 h-6 rounded-lg text-purple-600 focus:ring-purple-500 border-slate-300 transition-all"
                    />
                    <label
                        for="giftcard-active"
                        class="text-sm font-black text-slate-700 uppercase tracking-tight cursor-pointer"
                        >Código Activo</label
                    >
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div
                        class="bg-slate-50/50 p-4 rounded-2xl border border-slate-50 text-center"
                    >
                        <p
                            class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1"
                        >
                            Usos Actuales
                        </p>
                        <p
                            id="current-uses"
                            class="text-2xl font-black text-slate-800"
                        >
                            0
                        </p>
                    </div>
                    <div
                        class="bg-slate-50/50 p-4 rounded-2xl border border-slate-50 text-center"
                    >
                        <p
                            class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1"
                        >
                            Creado el
                        </p>
                        <p
                            id="created-date"
                            class="text-sm font-black text-slate-800"
                        >
                            -
                        </p>
                    </div>
                </div>

                <button
                    type="submit"
                    class="w-full py-4 bg-purple-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-purple-100 hover:bg-purple-700 transition-all active:scale-95"
                >
                    ✨ Guardar Giftcard
                </button>
            </form>
        </div>

        <!-- Prices Card -->
        <div
            class="bg-white rounded-[2.5rem] shadow-sm border border-slate-50 overflow-hidden flex flex-col h-fit"
        >
            <header class="p-8 border-b border-slate-50 bg-emerald-50/30">
                <h3
                    class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2"
                >
                    <span class="text-2xl">💰</span> Precios de Planes
                </h3>
                <p
                    class="text-xs text-slate-500 font-bold mt-1 uppercase tracking-widest"
                >
                    Valor de suscripciones premium
                </p>
            </header>

            <form id="form-precios" class="p-8 space-y-6">
                <div>
                    <label
                        class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                        >Plan Mensual ($)</label
                    >
                    <input
                        type="number"
                        id="price-monthly"
                        placeholder="30000"
                        class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-bold focus:ring-2 focus:ring-emerald-500 outline-none transition-all"
                        required
                    />
                </div>
                <div>
                    <label
                        class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2"
                        >Plan Experto ($)</label
                    >
                    <input
                        type="number"
                        id="price-semestral"
                        placeholder="150000"
                        class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl font-bold focus:ring-2 focus:ring-emerald-500 outline-none transition-all"
                        required
                    />
                </div>
                <button
                    type="submit"
                    class="w-full py-4 bg-emerald-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-emerald-100 hover:bg-emerald-700 transition-all active:scale-95"
                >
                    🏦 Guardar Precios
                </button>
            </form>

            <footer class="p-8 pt-0">
                <div
                    class="bg-amber-50 border border-amber-100 p-4 rounded-2xl flex gap-3 italic"
                >
                    <span class="text-xl">⚠️</span>
                    <p
                        class="text-[11px] text-amber-700 font-medium leading-tight"
                    >
                        Los cambios de precios se aplicarán a las nuevas
                        suscripciones. Los usuarios con cobro recurrente activo
                        mantendrán su precio anterior hasta el próximo ciclo.
                    </p>
                </div>
            </footer>
        </div>
    </div>
</LayoutAdmin>

<script>
    import { db, auth } from "../../firebase/client";
    import { doc, getDoc, setDoc } from "firebase/firestore";
    import { onAuthStateChanged } from "firebase/auth";

    document.addEventListener("astro:page-load", () => {
        onAuthStateChanged(auth, async (user) => {
            if (user) loadConfig();
        });

        async function loadConfig() {
            try {
                // Cargar configuración del giftcard
                const giftcardRef = doc(db, "configuracion", "giftcard");
                const giftcardSnap = await getDoc(giftcardRef);

                if (giftcardSnap.exists()) {
                    const data = giftcardSnap.data();
                    const codeInput = document.getElementById(
                        "giftcard-code",
                    ) as HTMLInputElement;
                    const durationInput = document.getElementById(
                        "giftcard-duration",
                    ) as HTMLInputElement;
                    const planInput = document.getElementById(
                        "giftcard-plan",
                    ) as HTMLSelectElement;
                    const maxUsesInput = document.getElementById(
                        "giftcard-max-uses",
                    ) as HTMLInputElement;
                    const activeInput = document.getElementById(
                        "giftcard-active",
                    ) as HTMLInputElement;
                    const usesEl = document.getElementById("current-uses");
                    const dateEl = document.getElementById("created-date");

                    if (codeInput) codeInput.value = data.codigo || "";
                    if (durationInput)
                        durationInput.value = data.duracionDias || 60;
                    if (planInput)
                        planInput.value = data.planOtorgado || "experto";
                    if (maxUsesInput) maxUsesInput.value = data.maxUsos || "";
                    if (activeInput) activeInput.checked = data.activo || false;
                    if (usesEl) usesEl.innerText = data.usos || 0;

                    if (data.fechaCreacion && dateEl) {
                        const fecha = data.fechaCreacion.toDate();
                        dateEl.innerText = fecha.toLocaleDateString("es-AR", {
                            day: "2-digit",
                            month: "2-digit",
                            year: "numeric",
                        });
                    }
                }

                // Cargar precios
                const generalRef = doc(db, "configuracion", "general");
                const generalSnap = await getDoc(generalRef);

                if (generalSnap.exists()) {
                    const data = generalSnap.data();
                    const monthlyInput = document.getElementById(
                        "price-monthly",
                    ) as HTMLInputElement;
                    const semestralInput = document.getElementById(
                        "price-semestral",
                    ) as HTMLInputElement;

                    if (monthlyInput && data.price_monthly)
                        monthlyInput.value = data.price_monthly;
                    if (semestralInput && data.price_semestral)
                        semestralInput.value = data.price_semestral;
                }
            } catch (e) {
                console.error("Error loading admin config:", e);
            }
        }

        // Guardar Giftcard
        document
            .getElementById("form-giftcard")
            ?.addEventListener("submit", async (e) => {
                e.preventDefault();
                const codeInput = document.getElementById(
                    "giftcard-code",
                ) as HTMLInputElement;
                const durationInput = document.getElementById(
                    "giftcard-duration",
                ) as HTMLInputElement;
                const planInput = document.getElementById(
                    "giftcard-plan",
                ) as HTMLSelectElement;
                const maxUsesInput = document.getElementById(
                    "giftcard-max-uses",
                ) as HTMLInputElement;
                const activeInput = document.getElementById(
                    "giftcard-active",
                ) as HTMLInputElement;

                const code = codeInput.value.trim().toUpperCase();
                const duration = parseInt(durationInput.value);
                const plan = planInput.value;
                const maxUses = maxUsesInput.value;
                const active = activeInput.checked;

                if (code.length < 3)
                    return alert("Código muy corto (mínimo 3 caracteres)");
                if (duration < 1)
                    return alert("Duración debe ser al menos 1 día");

                try {
                    const giftcardData: any = {
                        codigo: code,
                        duracionDias: duration,
                        planOtorgado: plan,
                        activo: active,
                        fechaCreacion: new Date(),
                    };

                    if (maxUses && parseInt(maxUses) > 0) {
                        giftcardData.maxUsos = parseInt(maxUses);
                    }

                    // Preservar el contador de usos actual
                    const currentDoc = await getDoc(
                        doc(db, "configuracion", "giftcard"),
                    );
                    giftcardData.usos = currentDoc.exists()
                        ? currentDoc.data().usos || 0
                        : 0;

                    await setDoc(
                        doc(db, "configuracion", "giftcard"),
                        giftcardData,
                        { merge: true },
                    );
                    alert("✅ Configuración de Giftcard guardada con éxito.");
                    loadConfig();
                } catch (e) {
                    console.error(e);
                    alert("Error al guardar la configuración de giftcard.");
                }
            });

        // Guardar Precios
        document
            .getElementById("form-precios")
            ?.addEventListener("submit", async (e) => {
                e.preventDefault();
                const monthly = (
                    document.getElementById("price-monthly") as HTMLInputElement
                ).value;
                const semestral = (
                    document.getElementById(
                        "price-semestral",
                    ) as HTMLInputElement
                ).value;

                try {
                    await setDoc(
                        doc(db, "configuracion", "general"),
                        {
                            price_monthly: monthly,
                            price_semestral: semestral,
                        },
                        { merge: true },
                    );
                    alert("✅ Precios de planes actualizados con éxito.");
                } catch (e) {
                    console.error(e);
                    alert("Error al guardar los precios.");
                }
            });
    });
</script>
