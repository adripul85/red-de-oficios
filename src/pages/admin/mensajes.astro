---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Buzón de Mensajes - Admin">
    <header
        class="flex flex-col md:flex-row justify-between items-center mb-10 gap-6"
    >
        <div>
            <h1
                class="text-3xl font-black text-slate-900 tracking-tight flex items-center gap-3"
            >
                <span class="text-3xl">📩</span> Buzón de Consultas
            </h1>
            <p class="text-slate-500 font-medium mt-1">
                Gestión de mensajes de contacto y soporte web
            </p>
        </div>

        <div
            class="bg-indigo-50 border border-indigo-100 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm"
        >
            <div class="w-2 h-2 bg-indigo-500 rounded-full animate-pulse"></div>
            <span
                id="unread-count"
                class="text-indigo-700 font-black text-xs uppercase tracking-widest"
                >Sincronizando...</span
            >
        </div>
    </header>

    <!-- LISTADO -->
    <div id="msg-list" class="space-y-6 min-h-[400px]">
        <!-- Skeleton / Loading -->
        <div class="flex items-center justify-center py-20">
            <div class="text-center">
                <div
                    class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto mb-4"
                >
                </div>
                <p
                    class="text-slate-400 font-black text-[10px] uppercase tracking-widest"
                >
                    Cargando buzón...
                </p>
            </div>
        </div>
    </div>
</LayoutAdmin>

<script>
    import { auth, db } from "../../firebase/client";
    import { onAuthStateChanged } from "firebase/auth";
    import {
        collection,
        onSnapshot,
        deleteDoc,
        doc,
        updateDoc,
        query,
        orderBy,
    } from "firebase/firestore";

    const listContainer = document.getElementById("msg-list");
    const unreadEl = document.getElementById("unread-count");

    document.addEventListener("astro:page-load", () => {
        onAuthStateChanged(auth, async (user) => {
            if (user) {
                initMessages();
            }
        });
    });

    function initMessages() {
        if (!listContainer) return;

        const q = query(
            collection(db, "mensajes_web"),
            orderBy("fecha", "desc"),
        );

        onSnapshot(
            q,
            (snap) => {
                if (unreadEl) {
                    const total = snap.size;
                    const pendientes = snap.docs.filter(
                        (d) => !d.data().respondido,
                    ).length;
                    unreadEl.textContent = `${pendientes} PENDIENTES / ${total} TOTAL`;
                }

                if (snap.empty) {
                    renderEmpty();
                    return;
                }

                const mensajes = snap.docs.map((d) => ({
                    id: d.id,
                    ...d.data(),
                }));
                renderMessages(mensajes);
            },
            (err) => {
                console.error("Error loading messages:", err);
                if (listContainer) {
                    listContainer.innerHTML = `
                    <div class="p-12 bg-rose-50 border border-rose-100 rounded-[2rem] text-center">
                        <p class="text-rose-600 font-black text-xs uppercase tracking-widest">Error de sincronización</p>
                        <p class="text-slate-500 text-sm mt-2 font-medium">No se pudieron cargar los mensajes. Verifica tu conexión o permisos.</p>
                    </div>
                `;
                }
            },
        );
    }

    function renderEmpty() {
        if (listContainer) {
            listContainer.innerHTML = `
                <div class="bg-indigo-50/50 border border-indigo-100 p-16 text-center rounded-[2.5rem] shadow-sm">
                    <div class="text-6xl mb-6">📭</div>
                    <h3 class="text-2xl font-black text-indigo-900 tracking-tight">Buzón vacío</h3>
                    <p class="text-indigo-600 mt-2 font-medium uppercase text-[10px] tracking-widest font-black">No hay consultas pendientes por el momento</p>
                </div>
            `;
        }
    }

    function renderMessages(mensajes) {
        if (!listContainer) return;
        listContainer.innerHTML = `
            <div class="grid gap-6">
                ${mensajes
                    .map(
                        (m) => `
                    <div class="bg-white border border-slate-100 rounded-[2.5rem] p-8 shadow-sm hover:shadow-md transition-all group relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-full -mr-16 -mt-16 group-hover:bg-indigo-50/50 transition-all duration-500"></div>
                        
                        <div class="relative z-10 flex flex-col md:flex-row justify-between gap-6">
                            <div class="flex-1">
                                <header class="flex flex-wrap items-center gap-4 mb-6">
                                    <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:bg-white transition-colors">👤</div>
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <h3 class="text-xl font-black text-slate-800 tracking-tight">${m.nombre || "Interesado Anónimo"}</h3>
                                            ${
                                                m.respondido
                                                    ? `<span class="bg-emerald-100 text-emerald-700 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-widest flex items-center gap-1 border border-emerald-200">✅ Respondido</span>`
                                                    : `<span class="bg-amber-100 text-amber-700 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-widest border border-amber-200">⏳ Pendiente</span>`
                                            }
                                        </div>
                                        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
                                            <span class="text-xs font-bold text-indigo-600 tracking-tight">${m.email}</span>
                                            <span class="text-xs font-bold text-slate-400">${m.telefono || "Sin contacto telefónico"}</span>
                                        </div>
                                    </div>
                                </header>

                                <div class="bg-slate-50 border border-slate-100 rounded-[2rem] p-6 mb-6 group-hover:bg-white transition-colors">
                                    <p class="text-slate-700 font-medium leading-relaxed italic text-sm">"${m.mensaje}"</p>
                                </div>

                                <footer class="flex items-center gap-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                    <span class="bg-slate-100/50 px-3 py-1.5 rounded-xl border border-slate-50">📅 ${m.fecha?.seconds ? new Date(m.fecha.seconds * 1000).toLocaleString("es-AR") : "Recientemente"}</span>
                                    <span class="hidden md:inline">ID: ${m.id.slice(-8).toUpperCase()}</span>
                                </footer>
                            </div>

                            <div class="flex md:flex-col items-center justify-center gap-3 min-w-[180px]">
                                <button 
                                    data-id="${m.id}"
                                    data-email="${m.email}"
                                    data-nombre="${m.nombre}"
                                    class="btn-reply w-full h-14 bg-indigo-600 text-white rounded-2xl font-black text-[11px] uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-slate-900 transition-all shadow-lg shadow-indigo-100 active:scale-95"
                                >
                                    <span>✉</span> Responder
                                </button>
                                <button 
                                    data-id="${m.id}"
                                    class="btn-delete w-full h-14 bg-white border border-slate-100 text-slate-400 rounded-2xl font-black text-[11px] uppercase tracking-widest hover:bg-rose-50 hover:text-rose-600 hover:border-rose-100 transition-all active:scale-95"
                                >
                                    Eliminar
                                </button>
                            </div>
                        </div>
                    </div>
                `,
                    )
                    .join("")}
            </div>
        `;

        // Event delegation
        listContainer.querySelectorAll(".btn-reply").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const { id, email, nombre } = target.dataset;
                if (id && email && nombre) handleReply(id, email, nombre);
            });
        });

        listContainer.querySelectorAll(".btn-delete").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const { id } = target.dataset;
                if (id) handleDeleteMsg(id);
            });
        });
    }

    async function handleReply(id: string, email: string, nombre: string) {
        const subject = encodeURIComponent(
            `Consulta Red de Oficios - Hola ${nombre}`,
        );
        const body = encodeURIComponent(
            `Hola ${nombre},\n\nGracias por contactarte con Red de Oficios. Recibimos tu consulta y queríamos responderte...\n\nSaludos,\nEquipo de Red de Oficios`,
        );

        window.open(
            `mailto:${email}?subject=${subject}&body=${body}`,
            "_blank",
        );

        try {
            await updateDoc(doc(db, "mensajes_web", id), {
                respondido: true,
                respondidoAt: new Date(),
                respondidoBy: auth.currentUser?.email,
            });
        } catch (e) {
            console.error("Error marking as responded:", e);
        }
    }

    async function handleDeleteMsg(id: string) {
        if (!confirm("⚠️ Se eliminará el mensaje permanentemente. ¿Continuar?"))
            return;
        try {
            await deleteDoc(doc(db, "mensajes_web", id));
        } catch (e) {
            alert("Error al borrar el mensaje.");
        }
    }
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    #msg-list {
        animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
</style>
