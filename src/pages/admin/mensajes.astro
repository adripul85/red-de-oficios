---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Buzón de Mensajes - Admin">
    <div class="min-h-screen bg-slate-50 py-12 px-4 shadow-inner">
        <div class="max-w-5xl mx-auto">
            <!-- HEADER -->
            <header class="flex flex-col md:flex-row justify-between items-center mb-10 gap-6">
                <div>
                    <a href="/admin" class="text-slate-400 hover:text-slate-600 font-bold text-sm mb-3 flex items-center gap-2 transition-colors uppercase tracking-widest">
                        <span>⬅</span> VOLVER AL PANEL
                    </a>
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight flex items-center gap-3">
                        <span class="text-3xl">📩</span> Buzón de Consultas
                    </h1>
                    <p class="text-slate-500 font-medium mt-1">Gestión de mensajes de contacto y soporte web</p>
                </div>

                <div class="bg-indigo-50 border border-indigo-100 rounded-2xl px-5 py-3 flex items-center gap-3 shadow-sm">
                    <div class="w-2 h-2 bg-indigo-500 rounded-full animate-pulse"></div>
                    <span id="unread-count" class="text-indigo-700 font-black text-xs uppercase tracking-widest">Sincronizando...</span>
                </div>
            </header>

            <!-- LISTADO -->
            <div id="msg-list" class="space-y-6">
                <!-- Skeleton / Loading -->
                <div class="flex items-center justify-center py-20">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600"></div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { auth, db } from "../../firebase/client";
    import { onAuthStateChanged } from "firebase/auth";
    import { 
        collection, 
        onSnapshot, 
        deleteDoc, 
        doc, 
        getDoc,
        updateDoc 
    } from "firebase/firestore";

    const listContainer = document.getElementById("msg-list");
    const unreadEl = document.getElementById("unread-count");

    document.addEventListener("astro:page-load", () => {
        onAuthStateChanged(auth, async (user) => {
            if (user) {
                const userDoc = await getDoc(doc(db, "profesionales", user.uid));
                const data = userDoc.data();
                const rol = (data?.rol || data?.role || "").toLowerCase().trim();
                
                const isStaff = rol === "admin" || rol === "moderador" || rol === "administrador";
                if (isStaff) {
                    initMessages();
                } else {
                    window.location.href = "/mi-perfil";
                }
            } else {
                window.location.href = "/ingresar";
            }
        });
    });

    function initMessages() {
        if (!listContainer) return;

        onSnapshot(collection(db, "mensajes_web"), (snap) => {
            if (unreadEl) {
                const total = snap.size;
                const pendientes = snap.docs.filter(d => !d.data().respondido).length;
                unreadEl.textContent = `${pendientes} PENDIENTES / ${total} TOTAL`;
            }
            
            if (snap.empty) {
                renderEmpty();
                return;
            }

            const mensajes = snap.docs.map(d => ({ id: d.id, ...d.data() }))
                .sort((a:any, b:any) => (b.fecha?.seconds || 0) - (a.fecha?.seconds || 0));

            renderMessages(mensajes);
        }, (err) => {
            console.error("Error cargando mensajes:", err);
            if (listContainer) {
                listContainer.innerHTML = `<div class="p-12 bg-red-50 border border-red-100 rounded-3xl text-center text-red-600 font-bold">Error de acceso: Asegúrate de tener permisos de admin y haber desplegado las reglas.</div>`;
            }
        });
    }

    function renderEmpty() {
        if (listContainer) {
            listContainer.innerHTML = `
                <div class="bg-indigo-50 border border-indigo-100 p-16 text-center rounded-[2.5rem] shadow-sm">
                    <div class="text-6xl mb-6">📭</div>
                    <h3 class="text-2xl font-black text-indigo-900 tracking-tight">Buzón vacío</h3>
                    <p class="text-indigo-600 mt-2 font-medium">No hay mensajes de contacto por el momento.</p>
                </div>
            `;
        }
    }

    function renderMessages(mensajes) {
        if (!listContainer) return;
        listContainer.innerHTML = `
            <div class="grid gap-6">
                ${mensajes.map(m => `
                    <div class="bg-white border border-slate-100 rounded-[2rem] p-8 shadow-sm hover:shadow-md transition-all group relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-full -mr-16 -mt-16 group-hover:bg-indigo-50 transition-colors"></div>
                        
                        <div class="relative z-10 flex flex-col md:flex-row justify-between gap-6">
                            <div class="flex-1">
                                <header class="flex flex-wrap items-center gap-3 mb-6">
                                    <div class="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center text-xl shadow-inner">👤</div>
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <h3 class="text-xl font-black text-slate-800 tracking-tight">${m.nombre || 'Anónimo'}</h3>
                                            ${m.respondido ? 
                                                `<span class="bg-emerald-100 text-emerald-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-widest flex items-center gap-1">✅ Respondido</span>` 
                                                : `<span class="bg-amber-100 text-amber-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-widest">⏳ Pendiente</span>`
                                            }
                                        </div>
                                        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
                                            <span class="text-xs font-bold text-indigo-600">${m.email}</span>
                                            <span class="text-xs font-bold text-slate-400 underline decoration-slate-200 decoration-2">${m.telefono || 'Sin teléfono'}</span>
                                        </div>
                                    </div>
                                </header>

                                <div class="bg-slate-50 border border-slate-100 rounded-3xl p-6 mb-6">
                                    <p class="text-slate-700 font-medium leading-relaxed italic text-sm">"${m.mensaje}"</p>
                                </div>

                                <footer class="flex items-center gap-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                    <span class="bg-white border border-slate-100 px-3 py-1 rounded-lg">📅 ${m.fecha?.seconds ? new Date(m.fecha.seconds * 1000).toLocaleString('es-AR') : 'Recientemente'}</span>
                                    <span>ID: ${m.id.slice(-8).toUpperCase()}</span>
                                </footer>
                            </div>

                            <div class="flex md:flex-col items-center justify-end gap-3 min-w-[160px]">
                                <button 
                                    onclick="handleReply('${m.id}', '${m.email}', '${m.nombre}')"
                                    class="w-full h-12 bg-indigo-600 text-white rounded-xl font-black text-[11px] uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-slate-900 transition-all shadow-lg shadow-indigo-100"
                                >
                                    <span>✉</span> Responder
                                </button>
                                <button 
                                    onclick="handleDeleteMsg('${m.id}')"
                                    class="w-full h-12 bg-white border border-slate-100 text-slate-400 rounded-xl font-black text-[11px] uppercase tracking-widest hover:bg-rose-50 hover:text-rose-600 hover:border-rose-100 transition-all"
                                >
                                    Eliminar
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;
    }

    (window as any).handleReply = async (id: string, email: string, nombre: string) => {
        // Build professional body
        const subject = encodeURIComponent(`Consulta Red de Oficios - Hola ${nombre}`);
        const body = encodeURIComponent(`Hola ${nombre},\n\nGracias por contactarte con Red de Oficios. Recibimos tu consulta y queríamos responderte...\n\nSaludos,\nEquipo de Red de Oficios`);
        
        // Open Mail
        window.open(`mailto:${email}?subject=${subject}&body=${body}`, '_blank');

        // Mark as responded in DB
        try {
            await updateDoc(doc(db, "mensajes_web", id), {
                respondido: true,
                respondidoAt: new Date(),
                respondidoBy: auth.currentUser?.email
            });
        } catch (e) {
            console.error("Error marking as responded:", e);
        }
    };

    (window as any).handleDeleteMsg = async (id: string) => {
        if (!confirm("⚠️ Se eliminará el mensaje permanentemente. ¿Continuar?")) return;
        try {
            await deleteDoc(doc(db, "mensajes_web", id));
        } catch (e) {
            alert("Error al borrar el mensaje.");
        }
    };
</script>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    #msg-list { animation: fadeIn 0.5s ease-out; }
</style>
