                    } catch (authError: any) {
                        console.warn(
                            "⚠️ [MI-CUENTA] Deletion en Auth requiere re-login o falló:",
                            authError,
                        );
                        // Si falla porque requiere login reciente, al menos cerramos sesión
                        await auth.signOut();
