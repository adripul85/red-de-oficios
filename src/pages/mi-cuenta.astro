                    if (s.status === "completada") {
                        statusLabel = "Finalizada";
                        statusClass = "bg-slate-100 text-slate-400";
                        icon = "🏁";
                    } else if (
                        s.status === "aceptada" ||
                        s.status === "en_progreso"
                    ) {
                        const proName = s.profesionalNombre || "El profesional";
                        statusLabel = `Trabajando con ${proName}`;
                        statusClass =
                            "bg-emerald-50 text-emerald-600 border-emerald-100";
                        icon = "🚀";

                        actionsHTML = `
                                    <button 
                                        onclick="cancelarTrabajo('${s.id}')"
                                        class="text-[10px] bg-amber-50 text-amber-600 font-black px-3 py-1.5 rounded-xl hover:bg-amber-100 transition-all uppercase tracking-widest border border-amber-100"
                                        title="El profesional no respondió o no hubo arreglo"
                                    >
                                        🔄 Republicar
                                    </button>
