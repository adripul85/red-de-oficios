                                            </svg>
                                        </div>
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">${fav.nombre}</h4>
<p class="text-sm text-slate-500">${fav.rubro_principal || "Profesional"} • ${fav.zona || "Buenos Aires"}</p>
                                        <div class="flex items-center gap-1 mt-1">
                                            ${
                                                fav.promedio > 0
                                                    ? `
<span class="text-yellow-500 text-xs">⭐ ${fav.promedio.toFixed(1)}</span>
                                                <span class="text-slate-400 text-xs">(${fav.total_votos || 0})</span>
