                        statusLabel = `${propuestas.length} presupuesto${propuestas.length > 1 ? "s" : ""}`;
                        statusClass =
                            "bg-indigo-50 text-indigo-600 border-indigo-100";
                        icon = "💬";
                    } else if (contactados > 0) {
                        statusLabel = `${contactados} contactos`;
                        statusClass =
                            "bg-blue-50 text-blue-600 border-blue-100";
                        icon = "💬";
                    } else if (candidatos > 0) {
                        statusLabel = "Buscando expertos...";
                        statusClass =
                            "bg-amber-50 text-amber-600 border-amber-100";
                        icon = "🔍";
                    }

                    let securityCodeHTML = "";
                    if (s.trabajoAceptadoPor && s.codigoSeguridad) {
                        securityCodeHTML = `
                                    <div class="mt-5 bg-gradient-to-br from-emerald-500 to-green-600 rounded-3xl p-6 shadow-xl border-4 border-white/20 relative overflow-hidden group">
                                        <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-3xl -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-700"></div>
                                        
                                        <div class="relative z-10">
                                            <div class="flex items-center gap-2 mb-4 bg-white/20 backdrop-blur-md rounded-xl px-3 py-1.5 w-fit">
                                                <span class="text-lg">🛡️</span>
                                                <span class="text-[10px] font-black uppercase tracking-widest text-white">Código de Seguridad</span>
                                            </div>

                                            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-6 mb-6 text-center transform group-hover:scale-[1.02] transition-transform duration-300">
                                                <p class="text-4xl font-black text-white tracking-[0.3em] drop-shadow-lg">${s.codigoSeguridad}</p>
                                                <p class="text-[10px] text-green-100 font-medium mt-3 uppercase tracking-wider opacity-80">Proporcionar solo al finalizar el trabajo</p>
                                            </div>
                                            
                                            ${
                                                s.profesionalNombre ||
                                                s.profesionalId
                                                    ? `
                                            <div class="bg-white/95 backdrop-blur-sm rounded-2xl p-4 mb-4 shadow-xl flex items-center gap-4 border border-white">
                                                <div class="relative">
