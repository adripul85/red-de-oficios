                    window.location.href = "/";
                } catch (error: any) {
                    console.error(
                        "❌ [MI-CUENTA] Error eliminando cuenta:",
                        error,
                    );
                    let msg = "No se pudo eliminar la cuenta.";
                    if (error.code === "permission-denied")
                        msg =
                            "No tenés permisos para borrar tus datos (Error de reglas).";

                    Swal.fire({
                        title: "Error",
                        text: msg + " Por favor contactá a soporte.",
                        icon: "error",
                    });
                }
            }
        });

        // --- FUNCIONES DE PRESUPUESTOS ---
        (window as any).rechazarPresupuesto = async (
            solicitudId: string,
            propuestaId: string,
        ) => {
            const result = await Swal.fire({
                title: "¿Rechazar Presupuesto?",
                text: "El presupuesto será eliminado y la solicitud volverá a estar disponible para otros profesionales.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#ef4444",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Sí, rechazar",
                cancelButtonText: "Cancelar",
            });

            if (!result.isConfirmed) return;

            try {
                // Get proposal data to know who to notify before deleting
                // @ts-ignore
                const proposalRef = doc(
                    db,
                    "solicitudes",
                    solicitudId,
                    "propuestas",
                    propuestaId,
                );
                const proposalSnap = await getDoc(proposalRef);
                const proposalData = proposalSnap.data();

                // Track rejected proposals in the solicitud document
                const solRef = doc(db, "solicitudes", solicitudId);
                const solSnap = await getDoc(solRef);
                const solData = solSnap.data();
                const rechazados = solData?.propuestasRechazadas || [];

                // Add this propuesta to rejected list if not already there
                if (!rechazados.includes(propuestaId)) {
                    rechazados.push(propuestaId);
                }

                // Update solicitud with rejected proposals list and keep it open
                await updateDoc(solRef, {
                    status: "nueva",
                    propuestasRechazadas: rechazados,
                });

                // NOTIFY PROFESSIONAL
                if (proposalData && proposalData.proId) {
                    try {
                        const { addDoc, collection, serverTimestamp } =
                            await import("firebase/firestore");
                        await addDoc(
                            collection(
                                db,
                                "profesionales",
                                proposalData.proId,
                                "notificaciones",
                            ),
                            {
                                tipo: "presupuesto_rechazado",
                                titulo: "Presupuesto Rechazado",
                                mensaje: `Tu presupuesto para "${solData?.rubro || "el trabajo"}" ha sido desestimado por el cliente.`,
                                fecha: serverTimestamp(),
                                leido: false,
                                link: "/panel/presupuestos",
                            },
                        );
                    } catch (notifError) {
                        console.error(
                            "Error enviando notificación de rechazo:",
                            notifError,
                        );
                    }
                }

                await loadMisSolicitudes(currentUser.uid);

                Swal.fire({
                    title: "Rechazado",
                    text: "El presupuesto fue rechazado. Tu solicitud está nuevamente abierta.",
                    icon: "success",
                    timer: 2000,
                    showConfirmButton: false,
                });
            } catch (e) {
                console.error("Error rechazando presupuesto:", e);
                Swal.fire(
                    "Error",
                    "No se pudo rechazar el presupuesto.",
                    "error",
                );
            }
        };

        (window as any).aceptarPresupuesto = async (
            solicitudId: string,
            propuestaId: string,
            proId: string,
        ) => {
            const result = await Swal.fire({
                title: "¿Aceptar Presupuesto?",
                text: "Este profesional será asignado a tu solicitud.",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#16a34a",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Sí, aceptar",
                cancelButtonText: "Cancelar",
            });

            if (!result.isConfirmed) return;

            try {
                // Load solicitud data to get client phone
                const solRef = doc(db, "solicitudes", solicitudId);
                const solSnap = await getDoc(solRef);
                const solData = solSnap.data();

                // Load professional data
                const proDoc = await getDoc(doc(db, "profesionales", proId));
                if (!proDoc.exists()) {
                    throw new Error("Profesional no encontrado");
                }

                const proData = proDoc.data();

                // Generate 6-digit security code
                const codigoSeguridad = Math.floor(
                    100000 + Math.random() * 900000,
                ).toString();

                // Update solicitud with professional info including contact details
                await updateDoc(solRef, {
                    status: "aceptada",
                    profesionalId: proId,
                    profesionalNombre: proData.nombre || "Profesional",
                    profesionalFoto: proData.foto || "",
                    profesionalTelefono: proData.telefono || "",
                    profesionalEmail: proData.email || "",
                    codigoSeguridad: codigoSeguridad,
                    trabajoAceptadoPor: proId,
                });

                // Save code to professional's codigos subcollection
                const { addDoc, collection, serverTimestamp } =
                    await import("firebase/firestore");
                await addDoc(
                    collection(db, "profesionales", proId, "codigos"),
                    {
                        codigo: codigoSeguridad,
                        solicitudId: solicitudId,
                        clienteId: currentUser.uid,
                        fecha: serverTimestamp(),
                        usado: false,
                    },
                );

                // NOTIFY PROFESSIONAL
                try {
                    await addDoc(
                        collection(
                            db,
                            "profesionales",
                            proId,
                            "notificaciones",
                        ),
                        {
                            tipo: "presupuesto_aceptado",
                            titulo: "¡Presupuesto Aceptado! 🚀",
                            mensaje: `¡Felicidades! ${currentUser.displayName || "El cliente"} ha aceptado tu presupuesto para "${solData?.rubro || "el trabajo"}".`,
                            clienteNombre: currentUser.displayName || "Cliente",
                            clienteEmail: currentUser.email || "",
                            clienteFoto: currentUser.photoURL || "",
                            clienteTelefono: solData?.telefono || "",
                            codigoSeguridad: codigoSeguridad,
                            fecha: serverTimestamp(),
                            leido: false,
                            link: "/panel/oportunidades",
                        },
                    );
                } catch (notifError) {
                    console.error(
                        "Error enviando notificación de aceptación:",
                        notifError,
                    );
                }

                // Reload dashboard
                await loadMisSolicitudes(currentUser.uid);
                // Clear any budget related notifications
                clearSpecificNotif(currentUser.uid, solicitudId);

                // Show professional details modal
                Swal.fire({
                    title: "✅ ¡Presupuesto Aceptado!",
                    html: `
                        <div class="text-left space-y-4">
                            <div class="flex items-center gap-3 bg-slate-50 p-4 rounded-xl">
                                <img src="${proData.foto || "/default-avatar.png"}" alt="${proData.nombre}" class="w-16 h-16 rounded-full object-cover border-2 border-green-500" />
                                <div>
                                    <h3 class="font-bold text-lg text-slate-900">${proData.nombre || "Profesional"}</h3>
                                    <p class="text-sm text-slate-500">${proData.rubro_principal || "Profesional"}</p>
                                </div>
                            </div>
                            

                            <div class="space-y-2 text-sm">
                                ${
                                    proData.telefono
                                        ? `
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold">📱 Teléfono:</span>
                                        <a href="https://wa.me/549${proData.telefono.replace(/\D/g, "")}" target="_blank" class="text-green-600 hover:underline">${proData.telefono}</a>
                                    </div>
                                `
                                        : ""
                                }
                                ${
                                    proData.email
                                        ? `
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold">📧 Email:</span>
                                        <span class="text-slate-700">${proData.email}</span>
                                    </div>
                                `
                                        : ""
                                }
                                ${
                                    proData.promedio
                                        ? `
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold">⭐ Calificación:</span>
                                        <span class="text-yellow-600">${proData.promedio.toFixed(1)}/5</span>
                                    </div>
                                `
                                        : ""
                                }
                            </div>

                            ${
                                proData.telefono
                                    ? `
                                <a href="https://wa.me/549${proData.telefono.replace(/\D/g, "")}" target="_blank" class="block w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-xl transition text-center">
                                    💬 Contactar por WhatsApp
                                </a>
                            `
                                    : ""
                            }
                        </div>
                    `,
                    width: "500px",
                    confirmButtonText: "Entendido",
                    confirmButtonColor: "#16a34a",
                });
            } catch (e) {
                console.error("Error aceptando presupuesto:", e);
                Swal.fire(
                    "Error",
                    "No se pudo aceptar el presupuesto. Intenta nuevamente.",
                    "error",
                );
            }
        };

        (window as any).renderClientBudgetPDF = async (data: any) => {
            const { jsPDF } = window as any;
            if (!jsPDF) {
                Swal.fire("Error", "Librería de PDF no cargada", "error");
                return;
            }

            const doc = new jsPDF();
            const margin = 20;
            let y = margin;

            // Branding
            doc.setFillColor(79, 70, 229); // Indigo 600
            doc.rect(0, 0, 210, 40, "F");

            doc.setTextColor(255, 255, 255);
            doc.setFontSize(24);
            doc.setFont("helvetica", "bold");
            doc.text("RED DE OFICIOS", margin, 25);

            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");
            doc.text("PRESUPUESTO PROFESIONAL", margin, 32);

            // Client & Info
            y = 55;
            doc.setTextColor(30, 41, 59); // Slate 800
            doc.setFontSize(14);
            doc.setFont("helvetica", "bold");
            doc.text(`Presupuesto para: ${data.titulo}`, margin, y);

            y += 10;
            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");
            doc.text(`Cliente: ${data.cliente}`, margin, y);
            doc.text(
                `Fecha: ${new Date().toLocaleDateString("es-AR")}`,
                150,
                y,
            );

            y += 15;
            doc.setDrawColor(226, 232, 240); // Slate 200
            doc.line(margin, y, 190, y);

            // Table Header
            y += 15;
            doc.setFont("helvetica", "bold");
            doc.text("Descripción", margin, y);
            doc.text("Cant.", 140, y, { align: "center" });
            doc.text("Precio", 170, y, { align: "right" });

            y += 5;
            doc.line(margin, y, 190, y);

            // Table Body
            y += 10;
            doc.setFont("helvetica", "normal");
            data.items.forEach((item: any) => {
                const lines = doc.splitTextToSize(item.desc, 110);
                doc.text(lines, margin, y);
                doc.text(item.cant.toString(), 140, y, { align: "center" });
                doc.text(
                    `$${parseInt(item.precio).toLocaleString("es-AR")}`,
                    170,
                    y,
                    { align: "right" },
                );
                y += lines.length * 5 + 5;
            });

            // Total
            y += 10;
            doc.setDrawColor(79, 70, 229);
            doc.setLineWidth(1);
            doc.line(130, y, 190, y);

            y += 12;
            doc.setFontSize(16);
            doc.setFont("helvetica", "bold");
            doc.setTextColor(79, 70, 229);
            doc.text("TOTAL ESTIMADO:", 130, y);
            doc.text(
                `$${parseInt(data.total).toLocaleString("es-AR")}`,
                190,
                y,
                { align: "right" },
            );

            // Footer
            doc.setFontSize(8);
            doc.setTextColor(148, 163, 184);
            doc.text(
                "Este es un presupuesto generado a través de Red de Oficios.",
                105,
                285,
                { align: "center" },
            );
            doc.text(
                "La validez del mismo depende del acuerdo final con el profesional.",
                105,
                290,
                { align: "center" },
            );

            doc.save(`Presupuesto-${data.titulo.replace(/\s+/g, "-")}.pdf`);

            Swal.fire({
                title: "¡PDF Generado!",
                text: "El presupuesto se ha descargado correctamente.",
                icon: "success",
                timer: 2000,
                showConfirmButton: false,
            });
        };

        // Mark solicitud as read
        (window as any).marcarSolicitudLeida = async (solicitudId: string) => {
            if (!currentUser) return;

            try {
                const {
                    collection,
                    query,
                    where,
                    getDocs,
                    updateDoc: updateDocFn,
                    doc: docFn,
                } = await import("firebase/firestore");
                const notifsRef = collection(
                    db,
                    "clientes",
                    currentUser.uid,
                    "notificaciones",
                );
                const q = query(
                    notifsRef,
                    where("solicitudId", "==", solicitudId),
                    where("leida", "==", false),
                );
                const snap = await getDocs(q);

                const promises = snap.docs.map((d) =>
                    updateDocFn(
                        docFn(
                            db,
                            "clientes",
                            currentUser.uid,
                            "notificaciones",
                            d.id,
                        ),
                        { leida: true },
                    ),
                );
                await Promise.all(promises);

                // Refresh notifications
                await loadClientNotifications(currentUser.uid);
            } catch (e) {
                console.error("Error marcando notificaciones como leídas:", e);
            }
        };

        // --- NOTIFICACIONES ---
        let isFirstNotifLoadClient = true;

        async function loadClientNotifications(userId: string) {
            const badge = document.getElementById("notif-badge-pedidos");
            if (unsubNotifs) unsubNotifs();

            try {
                const { collection, query, where, onSnapshot } =
                    await import("firebase/firestore");
                const q = query(
                    collection(db, "clientes", userId, "notificaciones"),
                    where("leida", "==", false),
                );

                unsubNotifs = onSnapshot(q, (snap) => {
                    const counts = new Map();

                    snap.docs.forEach((d) => {
                        const solId = d.data().solicitudId;
                        if (solId) {
                            counts.set(solId, (counts.get(solId) || 0) + 1);
                        }
                    });

                    // Toast logic for new notifications
                    if (!isFirstNotifLoadClient) {
                        snap.docChanges().forEach((change) => {
                            if (change.type === "added") {
                                const notif = change.doc.data();
                                if (
                                    notif.tipo === "presupuesto" ||
                                    notif.tipo === "presupuesto_aceptado"
                                ) {
                                    Swal.fire({
                                        title:
                                            notif.titulo ||
                                            "¡Nueva notificación!",
                                        text: notif.mensaje,
                                        icon: "info",
                                        toast: true,
                                        position: "top-end",
                                        showConfirmButton: false,
                                        timer: 5000,
                                        timerProgressBar: true,
                                        background: "#fff",
                                        color: "#1e293b",
                                        iconColor: "#3b82f6",
                                    });
                                }
                            }
                        });
                    }
                    isFirstNotifLoadClient = false;

                    unreadSolicitudes = counts;

                    if (badge) {
                        if (unreadSolicitudes.size > 0) {
                            badge.classList.remove("hidden");
                            badge.innerText = unreadSolicitudes.size.toString();
                            badge.className =
                                "absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] flex items-center justify-center rounded-full font-bold border-2 border-white shadow-sm";
                        } else {
                            badge.classList.add("hidden");
                        }
                    }

                    // Re-render solicitudes list to show/hide dots
                    if (auth.currentUser) {
                        loadMisSolicitudes(auth.currentUser.uid);
                    }
                });
            } catch (e) {
                console.error("Error notifs:", e);
            }
        }

        (window as any).verNotificacion = async (id: string, solId: string) => {
            if (!currentUser) return;
            // Mark as read first
            await marcarLeida(id);
            // Switch to solicitudes tab
            const btn = document.querySelector(
                '[data-tab="solicitudes"]',
            ) as HTMLElement;
            btn?.click();
            // Scroll to the solicitud if possible (optional)
        };

        async function marcarLeida(notifId: string) {
            if (!currentUser) return;
            try {
                const { updateDoc, doc } = await import("firebase/firestore");
                await updateDoc(
                    doc(
                        db,
                        "clientes",
                        currentUser.uid,
                        "notificaciones",
                        notifId,
                    ),
                    {
                        leida: true,
                    },
                );
            } catch (e) {
                console.error("Error marking read:", e);
            }
        }
        (window as any).marcarLeida = marcarLeida;

        (window as any).borrarNotif = async (notifId: string) => {
            if (!currentUser) return;
            try {
                const { deleteDoc, doc } = await import("firebase/firestore");
                await deleteDoc(
                    doc(
                        db,
                        "clientes",
                        currentUser.uid,
                        "notificaciones",
                        notifId,
                    ),
                );
            } catch (e) {
                console.error("Error deleting notif:", e);
            }
        };

        async function clearSpecificNotif(userId, solId) {
            try {
                const { collection, query, where, getDocs, deleteDoc } =
                    await import("firebase/firestore");
                const q = query(
                    collection(db, "clientes", userId, "notificaciones"),
                    where("solicitudId", "==", solId),
                );
                const snap = await getDocs(q);
                snap.docs.forEach((d) => deleteDoc(d.ref));
            } catch (e) {}
        }

        async function marcarSolicitudLeida(solId: string) {
            if (!currentUser || !unreadSolicitudes.has(solId)) return;

            try {
                const { collection, query, where, getDocs, updateDoc } =
                    await import("firebase/firestore");
                const q = query(
                    collection(
                        db,
                        "clientes",
                        currentUser.uid,
                        "notificaciones",
                    ),
                    where("solicitudId", "==", solId),
                    where("leida", "==", false),
                );
                const snap = await getDocs(q);
                const promises = snap.docs.map((doc) =>
                    updateDoc(doc.ref, { leida: true }),
                );
                await Promise.all(promises);
                console.log(`✅ [NOTIF] Solicitud ${solId} marcada como leída`);
                // El onSnapshot de loadClientNotifications hará el resto
            } catch (e) {
                console.error("Error al marcar solicitud como leída:", e);
            }
        }
    </script>
</Layout>
