        // --- FUNCIONES GLOBALES DE GESTIÓN ---
        (window as any).cancelarTrabajo = async (id: string) => {
            if (!currentUser) return;

            const result = await Swal.fire({
                title: "¿Volver a Publicar?",
                text: "El trabajo volverá a estar disponible para otros profesionales. Úsalo si el profesional actual no respondió.",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#f97316",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Sí, republicar",
                cancelButtonText: "Cancelar",
            });

            if (!result.isConfirmed) return;

            try {
                // @ts-ignore
                const docRef = doc(db, "solicitudes", id);
                await updateDoc(docRef, {
                    status: "pendiente",
                    profesionalId: deleteField(),
                    profesionalNombre: deleteField(),
                    profesionalFoto: deleteField(),
                });

                await loadMisSolicitudes(currentUser.uid);

                Swal.fire({
                    title: "¡Republicada!",
                    text: "Tu solicitud está visible nuevamente en la bolsa de trabajo.",
                    icon: "success",
                    timer: 2000,
                    showConfirmButton: false,
                });
            } catch (e) {
                console.error(e);
                Swal.fire(
                    "Error",
                    "No se pudo actualizar la solicitud.",
                    "error",
                );
            }
        };

        (window as any).borrarSolicitud = async (id: string) => {
            const result = await Swal.fire({
                title: "¿Eliminar Solicitud?",
                text: "Se perderá el historial y los profesionales no podrán contactarte.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#ef4444",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
            });

            if (!result.isConfirmed) return;

            try {
                const solicitudDoc = await getDoc(doc(db, "solicitudes", id));

                // If there's a professional assigned with a security code, delete it
                if (
                    solicitudDoc.exists() &&
                    solicitudDoc.data().profesionalId &&
                    solicitudDoc.data().codigoSeguridad
                ) {
                    const proId = solicitudDoc.data().profesionalId;

                    // Find and delete the code from professional's codigos subcollection
                    const {
                        collection,
                        query,
                        where,
                        getDocs,
                        deleteDoc: delDoc,
                    } = await import("firebase/firestore");
                    const codigosQuery = query(
                        collection(db, "profesionales", proId, "codigos"),
                        where("solicitudId", "==", id),
                    );
                    const codigosSnap = await getDocs(codigosQuery);

                    // Delete all matching codes
                    const deletePromises = codigosSnap.docs.map((codeDoc) =>
                        delDoc(
                            doc(
                                db,
                                "profesionales",
                                proId,
                                "codigos",
                                codeDoc.id,
                            ),
                        ),
                    );
                    await Promise.all(deletePromises);
                }

                // Now delete the solicitud itself
                await deleteDoc(doc(db, "solicitudes", id));
                if (currentUser) await loadMisSolicitudes(currentUser.uid);

                Swal.fire({
                    title: "Eliminada",
                    text: "La solicitud ha sido eliminada.",
                    icon: "success",
                    timer: 2000,
                    showConfirmButton: false,
                });
            } catch (e) {
                console.error(e);
                Swal.fire(
                    "Error",
                    "No se pudo eliminar la solicitud.",
                    "error",
                );
            }
        };

        (window as any).quitarFavorito = async (proId: string) => {
