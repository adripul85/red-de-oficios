                        );
                    } catch (favErr) {
                        console.warn(
                            "⚠️ [MI-CUENTA] No se pudo borrar el documento de favoritos (quizás no existía):",
                            favErr,
                        );
                    }

                    // 3. Borrar Auth User (si es reciente)
                    try {
                        await currentUser.delete();
                        console.log(
                            "✅ [MI-CUENTA] Usuario de Firebase Auth eliminado",
