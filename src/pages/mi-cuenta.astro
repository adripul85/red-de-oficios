                            // Since we store the full object in 'profesionales' array in favorites,
                            // we usually don't need to re-fetch, but let's be safe and use what we have.
                            // If the stored data is minimal (just ID), we would need to fetch.
                            // Based on perfil.astro, we likely store { id, nombre, etc... }
                            // Let's assume the stored data is sufficient for display.

                            favList.innerHTML = favs
                                .map(
                                    (fav: any) => `
                            <div class="flex items-center gap-4 p-4 bg-slate-50 hover:bg-blue-50 rounded-2xl transition-all border border-transparent hover:border-blue-200 group relative">
                                <a href="/perfil?id=${fav.id}" class="flex-1 flex items-center gap-4">
