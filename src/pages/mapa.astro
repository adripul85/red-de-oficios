---
import Layout from "../layouts/Layout.astro";
import { db } from "../firebase/client";
import { collection, getDocs } from "firebase/firestore";
import { BARRIOS_COORDENADAS } from "../consts/coordenadas";

// 1. TRAER DATOS
const snapshot = await getDocs(collection(db, "profesionales"));

const profesionales = snapshot.docs
  .map((doc) => {
    const data = doc.data();
    const zona = data.zona || "";

    // --- 🔥 FILTRO DE SEGURIDAD: OCULTAR FREE ---

    const plan = data.plan || "gratuito";
    // Si el plan es alguno de estos, NO lo mostramos en el mapa
    if (plan === "semilla" || plan === "gratuito" || plan === "prueba_gratis") {
      return null;
    }

    // 1. Ubicación exacta

    let lat = null,
      lng = null;

    if (data.ubicacion_exacta && data.ubicacion_exacta.lat) {
      lat = data.ubicacion_exacta.lat;
      lng = data.ubicacion_exacta.lng;
    }
    // 2. Barrio Genérico (Fallback)

    else if (BARRIOS_COORDENADAS && BARRIOS_COORDENADAS[zona]) {
      const coords = BARRIOS_COORDENADAS[zona];
      const noise = () => (Math.random() - 0.5) * 0.008;
      lat = coords[0] + noise();
      lng = coords[1] + noise();
    }

    // Clasificación para el color del pin

    const esExperto = data.plan === "experto" || data.plan === "semestral";
    const esPro = data.plan === "mensual" || data.plan === "profesional";

    let nivel = "basico";
    if (esExperto) nivel = "experto";
    else if (esPro) nivel = "pro";
    else return null; // Eliminar pines azules (básicos)


    return {
      id: doc.id,
      nombre: data.nombre,
      categoria: data.rubro_principal || "Profesional",
      foto: data.foto,
      nivel,
      coords: { lat, lng },
    };
  })
  .filter((p) => p !== null && p.coords.lat !== null); // Filtramos nulos y sin coords

const mapData = profesionales.map(p => ({
  i: p.id,
  n: p.nombre,
  c: p.categoria,
  f: p.foto,
  l: p.nivel,
  g: [p.coords.lat, p.coords.lng]
}));
---

<Layout title="Mapa de Profesionales - DeOficios" hideFooter={true}>
  <div class="map-page">
    <div class="map-sidebar">
      <div class="flex items-center gap-2 mb-4 md:mb-4">
        <span class="text-3xl">🗺️</span>
        <h1 class="text-xl font-bold text-gray-900">Mapa en Vivo</h1>
      </div>

      <button
        id="btn-locate"
        class="w-full bg-blue-600 text-white font-bold py-2 px-4 rounded-lg shadow hover:bg-blue-700 transition flex items-center justify-center gap-2 text-sm"
      >
        <span>📍</span> Ver mi ubicación
      </button>

      <div
        class="map-sidebar-info bg-gray-100 p-3 rounded-lg flex justify-between items-center text-sm mt-3"
      >
        <span class="font-bold text-gray-700">{profesionales.length}</span>
        <span class="text-gray-500">Profesionales activos</span>
      </div>

      <div class="map-sidebar-references space-y-2 text-sm mt-3">
        <p class="font-bold text-gray-700 text-xs uppercase tracking-wide">
          Referencias:
        </p>
        <div class="flex items-center gap-2">
          <img
            src="https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png"
            width="12"
            alt="Experto"
          />
          <span class="text-gray-600">Experto</span>
        </div>
        <div class="flex items-center gap-2">
          <img
            src="https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-gold.png"
            width="12"
            alt="Profesional"
          />
          <span class="text-gray-600">Profesional</span>
        </div>
      </div>

      <div
        class="mt-auto bg-gray-900 p-4 rounded-xl text-center text-white mt-4"
      >
        <p class="text-xs text-gray-400 mb-2">¿Quieres destacar aquí?</p>
        <a
          href="/planes"
          class="block bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold py-2 rounded-lg transition"
        >
          🚀 Obtener Pin Rojo
        </a>
      </div>

      <a
        href="/"
        class="back-link block text-center text-gray-500 text-xs hover:text-orange-600 font-bold mt-2"
        >⬅ Volver</a
      >
    </div>

    <div id="map" class="map-container touch-none"></div>

  </div>
</Layout>

<Fragment slot="head">
  <!-- Estilos de Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css"
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css"
  />

  <!-- Scripts de Leaflet (is:inline ensures they stay as globals in head) -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
</Fragment>


<script is:inline id="map-data" type="application/json" set:html={JSON.stringify(mapData)}></script>

<script is:inline>
  // Variable global para limpiar el mapa anterior (scoped to module or window)
  let mapInstance = null;

  function runMapSystem() {
    console.log("🗺️ [MAPA] Inicializando sistema de mapa...");

    const mapContainer = document.getElementById("map");
    if (!mapContainer) return;

    // 1. Limpieza RIGUROSA
    if (mapInstance) {
      try {
        mapInstance.off();
        mapInstance.remove();
        console.log("♻️ [MAPA] Instancia previa removida");
      } catch (e) {
        console.warn("⚠️ [MAPA] Error al remover instancia:", e);
      }
      mapInstance = null;
    }

    // Resetear contenedor
    mapContainer.innerHTML = "";
    // @ts-ignore
    delete mapContainer._leaflet_id;

    // 2. Esperar a que Leaflet esté disponible (Polling)
    let retryCount = 0;
    const maxRetries = 20;

    function attemptInit() {
      // @ts-ignore
      if (typeof L !== "undefined" && typeof L.markerClusterGroup !== "undefined") {
        initMap();
      } else if (retryCount < maxRetries) {
        retryCount++;
        console.log(`⏳ [MAPA] Esperando Leaflet... (${retryCount}/${maxRetries})`);
        setTimeout(attemptInit, 200);
      } else {
        console.error("❌ [MAPA] No se pudo cargar Leaflet tras múltiples intentos.");
      }
    }

    attemptInit();

    function initMap() {
      // @ts-ignore
      const L = window.L;
      if (!L) return;

      mapInstance = L.map("map", { 
        zoomControl: false,
        fadeAnimation: true,
        markerZoomAnimation: true
      }).setView([-34.6037, -58.3816], 6);

      L.control.zoom({ position: "bottomright" }).addTo(mapInstance);

      L.tileLayer(
        "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
        {
          attribution: "© OpenStreetMap",
          maxZoom: 19,
        },
      ).addTo(mapInstance);

      const IconFactory = (color) =>
        L.icon({
          iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-${color}.png`,
          shadowUrl: "https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png",
          iconSize: [25, 41],
          iconAnchor: [12, 41],
          popupAnchor: [1, -34],
          shadowSize: [41, 41],
        });

      const redIcon = IconFactory("red");
      const goldIcon = IconFactory("gold");
      const blueIcon = IconFactory("blue");

      const dataEl = document.getElementById("map-data");
      const pros = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
      console.log(`📍 [MAPA] Cargando ${pros.length} profesionales`);

      const markerCluster = L.markerClusterGroup({
        chunkedLoading: true,
        maxClusterRadius: 50,
        spiderfyOnMaxZoom: true,
        showCoverageOnHover: false
      });

      pros.forEach((p) => {
        let iconToUse = blueIcon;
        let zIndex = 100;

        if (p.l === "experto") {
          iconToUse = redIcon;
          zIndex = 1000;
        } else if (p.l === "pro") {
          iconToUse = goldIcon;
          zIndex = 500;
        }

        const fotoHtml = p.f
          ? `<img src="${p.f}" alt="${p.n}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid white;box-shadow:0 2px 5px rgba(0,0,0,0.2);display:block;margin:0 auto;">`
          : `<div style="width:40px;height:40px;border-radius:50%;background:#ccc;display:flex;align-items:center;justify-content:center;font-weight:bold;color:white;margin:0 auto;">${p.n[0]}</div>`;

        const popupContent = `
          <div style="text-align:center; font-family:sans-serif; min-width:160px; padding:5px;">
            <div style="margin-bottom:8px;">${fotoHtml}</div>
            <strong style="font-size:1rem; color:#111827; display:block; line-height:1.2;">${p.n}</strong>
            <span style="color:#ea580c; font-size:0.75rem; font-weight:bold; text-transform:uppercase; letter-spacing:0.5px;">${p.c}</span>
            <a href="/perfil?id=${p.i}" style="display:block; margin-top:10px; background:#111827; color:white; text-decoration:none; padding:6px 0; border-radius:6px; font-size:0.8rem; font-weight:bold;">Ver Perfil</a>
          </div>
        `;

        const marker = L.marker([p.g[0], p.g[1]], {
          icon: iconToUse,
          zIndexOffset: zIndex,
        }).bindPopup(popupContent);
        
        markerCluster.addLayer(marker);
      });

      mapInstance.addLayer(markerCluster);

      if (pros.length > 0) {
        try {
          mapInstance.fitBounds(markerCluster.getBounds(), {
              padding: [50, 50],
              maxZoom: 15,
          });
        } catch(e) {}
      }

      // 🛰️ AUTO-UBICACIÓN: Intentar centrar en el usuario al entrar
      console.log("🛰️ [MAPA] Intentando auto-ubicación...");
      mapInstance.locate({ setView: true, maxZoom: 14, enableHighAccuracy: true });

      // Geolocalización (Botón Manual)
      const btnLocate = document.getElementById("btn-locate");
      if (btnLocate) {
        btnLocate.addEventListener("click", () => {
          btnLocate.innerHTML = "<span>🔄</span> Buscando...";
          mapInstance.locate({ setView: true, maxZoom: 15 });
        });
      }

      mapInstance.on("locationfound", (e) => {
        const userIcon = L.divIcon({
          className: "user-location-marker",
          html: '<div style="background-color:#3b82f6;width:12px;height:12px;border-radius:50%;border:2px solid white;box-shadow:0 0 0 4px rgba(59,130,246,0.3);"></div>',
          iconSize: [20, 20],
        });
        L.marker(e.latlng, { icon: userIcon }).addTo(mapInstance);
        if (btnLocate) btnLocate.innerHTML = "<span>✅</span> Ubicado";
      });

      mapInstance.on("locationerror", (e) => {
        console.warn("📍 [MAPA] No se pudo obtener la ubicación:", e.message);
        if (btnLocate) btnLocate.innerHTML = "<span>📍</span> Ver mi ubicación";
      });
    }
  }

  // Ejecutar en cada carga de Astro
  document.addEventListener("astro:page-load", runMapSystem);
</script>

<style>
  .map-page {
    position: relative;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
  }
  .map-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .map-sidebar {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 300px;
    max-height: calc(100% - 40px);
    background: rgba(255, 255, 255, 0.95);
    padding: 20px;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    z-index: 10;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 768px) {
    .map-sidebar {
      top: 10px;
      left: 10px;
      right: 10px;
      bottom: auto;
      width: auto;
      border-radius: 16px;
      padding: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .map-sidebar h1, .map-sidebar .text-3xl {
      font-size: 1rem;
    }
    .map-sidebar .map-sidebar-info, .map-sidebar .map-sidebar-references, .map-sidebar .mt-auto {
      display: none; /* Hide non-essential info on mobile top bar */
    }
    .map-sidebar #btn-locate {
      width: auto;
      padding: 8px 12px;
      font-size: 0.75rem;
    }
    .map-sidebar .back-link {
        margin-left: auto;
    }
  }
</style>

