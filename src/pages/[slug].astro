<script>
    import { auth } from "../firebase/client";
    import Swal from 'sweetalert2';

    document.addEventListener("astro:page-load", () => {
        console.log("🚀 [REPORT-SCRIPT] Iniciando script de reportes...");
        
        // REPORT MODAL LOGIC - Module Script
        const reportModal = document.getElementById("report-modal");
        const btnOpenReport = document.getElementById("btn-open-report");
        
        // Debugging elements
        console.log("🧐 [REPORT-SCRIPT] Elementos detectados:", { 
            modal: !!reportModal, 
            btnNormal: !!btnOpenReport, 
            btnLanding: !!document.getElementById("btn-open-report-landing") 
        });

        // Helpers
        const safeAlert = (title, text, icon) => {
            if (typeof Swal !== 'undefined') {
                Swal.fire({ title, text, icon, confirmButtonColor: '#dc2626' });
            } else {
                alert(`${icon === 'success' ? '✅' : '❌'} ${title}\n\n${text}`);
            }
        };

        const btnCloseReport = document.getElementById("btn-close-report");
        const btnCancelReport = document.getElementById("btn-cancel-report");
        const formReport = document.getElementById("form-report-profile");

        function toggleReportModal(show) {
            if(show) {
                if (reportModal) reportModal.classList.remove("hidden");
            } else {
                if (reportModal) reportModal.classList.add("hidden");
            }
        }

        btnOpenReport?.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleReportModal(true);
        });
        
        // Listener for Landing Mode button
        const btnOpenReportLanding = document.getElementById("btn-open-report-landing");
        btnOpenReportLanding?.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleReportModal(true);
        });

        btnCloseReport?.addEventListener("click", () => toggleReportModal(false));
        btnCancelReport?.addEventListener("click", () => toggleReportModal(false));

        formReport?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = formReport.querySelector('button[type="submit"]');
            // @ts-ignore
            const originalText = btn.textContent;
            // @ts-ignore
            btn.disabled = true; btn.textContent = "Enviando...";

            try {
                // @ts-ignore
                const motivo = document.getElementById("report-motivo")?.value;
                // @ts-ignore
                const desc = document.getElementById("report-desc")?.value;
                
                // Get data from DOM
                const directoryContainer = document.getElementById("profile-directory");
                const landingContainer = document.getElementById("landing-profile-container");
                const pid = directoryContainer?.getAttribute("data-id") || landingContainer?.getAttribute("data-id");
                // @ts-ignore
                const pName = window.currentProName || "Profesional";

                const currentUser = auth.currentUser;

                const body = {
                    profesionalId: pid,
                    profesionalNombre: pName,
                    motivo,
                    descripcion: desc,
                    denuncianteUid: currentUser?.uid || null,
                    denuncianteEmail: currentUser?.email || null
                };

                const res = await fetch("/api/reportar", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(body)
                });

                const data = await res.json();
                if(!res.ok) throw new Error(data.error || "Error al enviar");

                // @ts-ignore
                Swal.fire({
                    icon: 'success',
                    title: 'Reporte Enviado',
                    text: 'Gracias por ayudarnos a mantener la comunidad segura.',
                    confirmButtonColor: '#dc2626'
                });
                
                toggleReportModal(false);
                // @ts-ignore
                formReport.reset();

            } catch (err) {
                console.error(err);
                // @ts-ignore
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se pudo enviar el reporte. Intenta nuevamente.',
                    confirmButtonColor: '#dc2626'
                });
            } finally {
                // @ts-ignore
                btn.disabled = false; btn.textContent = originalText;
            }
        });
    });
</script>
<script is:inline>
  // Script de respaldo y verificación inmediata
  async function registrarClickWhatsAppGlobal(uid) {
    console.log("🚀 [TRACK-DEBUG] Registrando click para:", uid);
    
    try {
      const response = await fetch('/api/track-click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid })
      });

      const data = await response.json();

      if (response.ok) {
        const display = document.getElementById('clicks-current');
        const progress = document.getElementById('clicks-progress');
        if (display) display.innerText = data.actual;
        if (progress) {
            const pct = Math.min((data.actual / 60) * 100, 100);
            progress.style.width = pct + "%";
        }
        console.log("✅ [TRACK-DEBUG] Nuevo valor:", data.actual);
        return true;
      }
      
      if (response.status === 403) {
        // @ts-ignore
        if (window.Swal) {
             window.Swal.fire({
                icon: 'error',
                title: 'Perfil en Pausa',
                text: 'Has alcanzado el límite de 60 contactos gratuitos.',
                confirmButtonText: 'Ver Planes',
                confirmButtonColor: '#ea580c'
            }).then(r => { if(r.isConfirmed) window.location.href = "/planes" });
        } else {
            alert("Límite de 60 clicks alcanzado.");
            window.location.href = "/planes";
        }
        return false;
      }
    } catch (error) {
      console.error("❌ [TRACK-DEBUG] Error:", error);
      return true;
    }
  }
</script>
