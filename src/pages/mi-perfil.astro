                                    console.warn(
                                        `⚠️ [PLAN] Corrigiendo duración del plan ${data.plan}: ${duracionEsperada} días`,
                                    );
                                    await updateDoc(
                                        fireDoc(db, "profesionales", uid),
                                        {
                                            plan_vencimiento:
                                                vencimientoCorrecto,
                                        },
                                    );
                                    // Recargar datos
