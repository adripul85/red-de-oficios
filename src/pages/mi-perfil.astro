                                    if (motivoAnt)
                                        motivoAnt.innerText = `Motivo: "${freshData.motivo_rechazo_antecedentes || "Documento inválido."}"`;
                                } else {
                                    bannerAnt?.classList.add("hidden");
                                }

                                // Actualizar también el plan por si cambió en tiempo real
                                let nPlan = (
                                    freshData.plan || "semilla"
                                ).toLowerCase();
                                if (
                                    nPlan === "gratuito" ||
                                    nPlan === "prueba_gratis"
                                )
                                    nPlan = "semilla";
                                if (nPlan === "profesional") nPlan = "mensual";
                                if (nPlan === "semestral") nPlan = "experto";
                                userPlan = nPlan;

