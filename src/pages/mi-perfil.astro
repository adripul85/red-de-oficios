                        const qrImg = clone.querySelector("#temp-card-qr");
                        // @ts-ignore
                        qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(profileUrl)}`;
                        // @ts-ignore
                        qrImg.crossOrigin = "anonymous";

                        // Esperar carga de imágenes
                        await Promise.all([
                            // @ts-ignore
                            new Promise((resolve) => {
                                if (
                                    avatarImg.complete &&
                                    avatarImg.naturalHeight !== 0
                                )
                                    resolve();
                                else {
                                    avatarImg.onload = resolve;
                                    avatarImg.onerror = resolve;
                                }
                            }),
                            // @ts-ignore
                            new Promise((resolve) => {
                                if (qrImg.complete) resolve();
                                else {
                                    qrImg.onload = resolve;
                                    qrImg.onerror = resolve;
                                }
                            }),
                            new Promise((resolve) => setTimeout(resolve, 1500)), // More time for images to settle
                        ]);

                        // 4. Renderizar
                        // @ts-ignore
                        const canvas = await html2canvas(
                            clone.firstElementChild,
                            {
                                scale: 2,
                                useCORS: true,
                                backgroundColor: "#ffffff",
                                logging: true,
                                allowTaint: false,
                            },
                        );

                        // Limpieza
                        document.body.removeChild(clone);

                        return { canvas, nombre };
                    } catch (error) {
                        console.error(error);
                        throw error;
                    }
                };

                document
                    .getElementById("btn-download-card-profile")
                    ?.addEventListener("click", async () => {
                        try {
                            const { canvas, nombre } =
                                await generateCardCanvas();
                            const link = document.createElement("a");
                            link.download = `Tarjeta-${nombre.replace(/\s+/g, "-")}.png`;
                            link.href = canvas.toDataURL("image/png");
                            link.click();

                            // @ts-ignore
                            Swal.fire({
                                icon: "success",
                                title: "¡Descargada!",
                                timer: 1500,
                                showConfirmButton: false,
                                width: "300px",
                                customClass: {
                                    popup: "rounded-[2rem] shadow-xl border border-slate-100",
                                },
                            });
                        } catch (error) {
                            // @ts-ignore
                            Swal.fire("Error", "No se pudo generar.", "error");
                        }
                    });

                document
                    .getElementById("btn-share-card-profile")
                    ?.addEventListener("click", async () => {
                        try {
                            const { canvas, nombre } =
                                await generateCardCanvas();

                            canvas.toBlob(async (blob) => {
                                if (!blob) return;
                                const file = new File(
                                    [blob],
                                    `Tarjeta-${nombre.replace(/\s+/g, "-")}.png`,
                                    { type: "image/png" },
                                );

                                if (
                                    navigator.share &&
                                    navigator.canShare({ files: [file] })
                                ) {
                                    await navigator.share({
                                        files: [file],
                                        title: "Mi Tarjeta Digital",
                                        text: "¡Mirá mi tarjeta digital de Oficios Argentina!",
                                    });
                                    // @ts-ignore
                                    Swal.close(); // Close loading
                                } else {
                                    // Fallback
                                    // @ts-ignore
                                    Swal.fire({
                                        title: "Tu navegador no soporta compartir directo",
                                        text: "La descargaremos en su lugar.",
                                        icon: "info",
                                        timer: 2500,
                                        showConfirmButton: false,
                                        width: "90%",
                                        maxWidth: "400px",
                                        customClass: {
                                            popup: "rounded-[2rem] shadow-xl border border-slate-100",
                                        },
                                    });
                                    const link = document.createElement("a");
                                    link.download = file.name;
                                    link.href = URL.createObjectURL(blob);
                                    link.click();
                                }
                            });
                        } catch (error) {
                            // @ts-ignore
                            Swal.fire("Error", "No se pudo generar.", "error");
                        }
                    });
            });
        </script>

        <script
