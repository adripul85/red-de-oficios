                                );

                                // Calcular diferencia en días entre el vencimiento actual y el correcto
                                const diferenciaDias = Math.abs(
                                    Math.ceil(
                                        (vencimientoActual -
                                            vencimientoCorrecto) /
                                            (1000 * 60 * 60 * 24),
                                    ),
                                );

                                // Si la diferencia es mayor a 5 días, corregir
