                        userData = data;

                        // Normalización temprana del plan para evitar inconsistencias
                        let nPlan = (data.plan || "semilla").toLowerCase();
                        if (nPlan === "gratuito" || nPlan === "prueba_gratis")
                            nPlan = "semilla";
                        if (nPlan === "profesional") nPlan = "mensual";
