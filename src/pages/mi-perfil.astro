                    counter.classList.add("hidden");
                    return;
                }

                counter.classList.remove("hidden");
                // Asegurarnos de que no tenga estilos inline que lo oculten
                counter.style.display = "block";
                document.getElementById("clicks-current").innerText = clicks;
                const pct = Math.min((clicks / 60) * 100, 100);
                const progressEl = document.getElementById("clicks-progress");
                if (progressEl) {
                    progressEl.style.width = `${pct}%`;
                    // Cambiar color si llega al final
                    if (clicks >= 60) {
                        progressEl.classList.remove("bg-orange-500");
                        progressEl.classList.add("bg-red-500");
                    } else if (clicks >= 50) {
                        progressEl.classList.remove("bg-orange-500");
                        progressEl.classList.add("bg-amber-500");
                    } else {
                        progressEl.classList.add("bg-orange-500");
                        progressEl.classList.remove(
                            "bg-red-500",
                            "bg-amber-500",
                        );
                    }
                }

                // Mostrar warning banner si llega a 50+
                const warningBanner = document.getElementById(
                    "clicks-warning-banner",
                );
                if (warningBanner) {
                    if (clicks >= 50 && clicks < 60)
                        warningBanner.classList.remove("hidden");
                    else warningBanner.classList.add("hidden");
                }

