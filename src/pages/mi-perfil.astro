---
import Layout from "../layouts/Layout.astro";
import { auth as authClient } from "../firebase/client";
import { sendEmailVerification } from "firebase/auth";
import IdentityWarning from "../components/profile/IdentityWarning.astro";
---

<Layout
    title="Mi Perfil Profesional - DeOficios"
    hideBottomNav={true}
    hideIA={true}
>
    <div class="bg-gray-50 min-h-screen pb-20 font-sans">
        <div class="container mx-auto px-4 py-8 max-w-7xl profile-page-wrapper">
            <!-- Banner de Verificación de Email -->
            <div
                id="email-verification-banner"
                class="hidden bg-orange-50 border border-orange-100 p-4 rounded-2xl mb-6"
            >
                <div
                    class="flex flex-col md:flex-row items-center justify-between gap-4"
                >
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">📧</span>
                        <div>
                            <p class="text-sm font-bold text-orange-800">
                                Tu correo no está verificado
                            </p>
                            <p class="text-xs text-orange-600">
                                Verifica tu email para mayor seguridad y recibir
                                alertas de trabajo.
                            </p>
                        </div>
                    </div>
                    <button
                        id="btn-resend-verification"
                        class="bg-orange-600 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-orange-700 transition"
                    >
                        Reenviar Email
                    </button>
                </div>
            </div>
            <div
                id="loading-overlay"
                class="fixed inset-0 bg-white z-[9999] flex flex-col items-center justify-center"
                style="display: flex;"
            >
                <div
                    class="animate-spin rounded-full h-16 w-16 border-4 border-gray-100 border-t-orange-500"
                >
                </div>
                <p class="mt-4 text-gray-500 font-medium animate-pulse">
                    Cargando tu perfil...
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                <aside class="lg:col-span-1 space-y-6">
                    <div
                        class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 text-center sticky top-24"
                    >
                        <div
                            class="relative w-28 h-28 md:w-36 md:h-36 mx-auto mb-4 group cursor-pointer"
                        >
                            <div
                                id="perfil-avatar"
                                class="w-full h-full rounded-full overflow-hidden border-4 border-orange-100 shadow-xl relative"
                            >
                                <img
                                    id="profile-img"
                                    src="/icon-512.png"
                                    alt="Foto de perfil"
                                    class="w-full h-full object-cover"
                                />
                                <div
                                    class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-[2px]"
                                    onclick="document.getElementById('file-foto').click()"
                                >
                                    <span class="text-2xl mb-1">📸</span>
                                    <span
                                        class="text-white text-[10px] font-bold tracking-wider uppercase"
                                        >Cambiar</span
                                    >
                                </div>
                                <input
                                    type="file"
                                    id="file-foto"
                                    class="hidden"
                                    accept="image/*"
                                />
                            </div>
                        </div>
                        <h3
                            id="sidebar-name"
                            class="font-black text-gray-900 text-lg"
                        >
                        </h3>
                        <p
                            id="sidebar-cuit"
                            class="text-[10px] text-gray-400 font-bold mt-1 uppercase tracking-tighter"
                        >
                        </p>
                        <div
                            id="badges-container"
                            class="flex flex-wrap justify-center gap-2 mt-2 mb-4"
                        >
                        </div>

                        <div
                            class="bg-orange-50 rounded-xl p-5 border border-orange-200 text-left relative overflow-hidden mb-4"
                        >
                            <div class="text-center mb-2">
                                <span
                                    class="text-[10px] text-orange-600 font-bold uppercase tracking-widest"
                                    >TU PLAN ACTUAL</span
                                >
                                <div
                                    id="plan-display"
                                    class="font-black text-gray-900 text-xl mt-1"
                                >
                                    ...
                                </div>
                            </div>

                            <div
                                id="click-counter"
                                class="mt-3 bg-white p-3 rounded-lg border border-orange-100"
                            >
                                <div
                                    class="flex justify-between text-xs font-bold mb-1"
                                >
                                    <span class="text-gray-600"
                                        >Contactos este mes:</span
                                    >
                                    <span class="text-orange-600"
                                        ><span id="clicks-current">0</span
                                        >/60</span
                                    >
                                </div>
                                <div
                                    class="w-full bg-gray-200 rounded-full h-2.5"
                                >
                                    <div
                                        id="clicks-progress"
                                        class="bg-orange-500 h-2.5 rounded-full"
                                        style="width: 0%"
                                    >
                                    </div>
                                </div>
                            </div>

                            <!-- Banner de Aviso (Te quedan X) -->
                            <div
                                id="clicks-warning-banner"
                                class="hidden mt-3 bg-amber-50 border-l-4 border-amber-400 p-3 rounded-r-lg"
                            >
                                <div class="flex items-center gap-2">
                                    <span class="text-amber-600">⚠️</span>
                                    <p
                                        class="text-[10px] text-amber-800 font-bold leading-tight"
                                    >
                                        ¡Atención! Te quedan pocos contactos
                                        gratuitos este mes. No pierdas clientes,
                                        pásate a Premium.
                                    </p>
                                </div>
                            </div>

                            <ul
                                id="plan-benefits"
                                class="space-y-2 text-sm text-gray-700 mt-4 mb-4"
                            >
                            </ul>
                            <!-- Tarjeta de Invitación a Mejora -->
                            <div
                                id="upgrade-invite-card"
                                class="hidden mt-4 mb-4 bg-orange-600 p-4 rounded-xl border border-orange-400 shadow-lg animate-bounce"
                            >
                                <p
                                    class="text-white text-[11px] font-black uppercase tracking-widest mb-1 text-center"
                                >
                                    ¡Límite Alcanzado!
                                </p>
                                <p
                                    class="text-white text-xs text-center font-medium opacity-90 leading-tight"
                                >
                                    Tu plan actual ya no permite nuevos
                                    contactos para los resultados de búsqueda.
                                    ¡Subí de nivel!
                                </p>
                            </div>

                            <a
                                href="/planes"
                                class="block w-full py-2.5 bg-gradient-to-r from-orange-500 to-orange-600 text-white text-sm font-bold rounded-lg text-center hover:shadow-lg transition text-shadow"
                                >⭐ Mejorar Plan</a
                            >
                        </div>

                        <div class="mt-6 space-y-2">
                            <a
                                href="#"
                                id="btn-ver-perfil"
                                class="block w-full py-2 px-4 border border-gray-200 text-gray-600 font-bold rounded-lg hover:bg-gray-50 transition text-sm text-center"
                            >
                                👀 Ver perfil público
                            </a>

                            <a
                                href="/panel"
                                id="btn-panel-pro"
                                class="hidden w-full py-2 px-4 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold rounded-lg hover:from-orange-600 hover:to-orange-700 transition text-sm text-center shadow-md transform hover:-translate-y-0.5 items-center justify-center gap-2"
                            >
                                <span>📊</span> Panel Pro
                            </a>

                            <button
                                id="btn-giftcard"
                                class="block w-full py-2 px-4 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold rounded-lg hover:from-purple-700 hover:to-indigo-700 transition text-sm text-center shadow-md transform hover:-translate-y-0.5"
                            >
                                🎁 Canjear Código
                            </button>

                            <div id="premium-tools" class="hidden space-y-2">
                                <button
                                    id="btn-show-qr-profile"
                                    class="w-full py-2 px-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-lg hover:from-purple-600 hover:to-pink-600 transition text-sm text-center shadow-md items-center justify-center gap-2"
                                >
                                    <span>📱</span> Ver Código QR
                                </button>

                                <button
                                    id="btn-share-card-profile"
                                    class="w-full py-2 px-4 bg-gradient-to-r from-blue-500 to-cyan-500 text-white font-bold rounded-lg hover:from-blue-600 hover:to-cyan-600 transition text-sm text-center shadow-md flex items-center justify-center gap-2"
                                >
                                    <span>📤</span> Compartir Tarjeta
                                </button>

                                <button
                                    id="btn-download-card-profile"
                                    class="w-full py-2 px-4 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold rounded-lg hover:from-indigo-600 hover:to-purple-600 transition text-sm text-center shadow-md flex items-center justify-center gap-2"
                                >
                                    <span>💳</span> Tarjeta Digital
                                </button>
                            </div>

                            <a
                                href="/admin/"
                                id="btn-admin-panel"
                                class="hidden w-full py-2 px-4 bg-gray-800 text-white font-bold rounded-lg hover:bg-black transition text-sm text-center"
                            >
                                🛡️ Panel Admin
                            </a>

                            <a
                                href="/foro"
                                class="block w-full py-2 px-4 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-lg hover:from-blue-600 hover:to-blue-700 transition text-sm text-center shadow-sm"
                            >
                                👥 Comunidad
                            </a>

                            <hr class="my-4 border-gray-100" />

                            <button
                                id="btn-logout"
                                class="w-full py-2 px-4 text-slate-400 hover:text-red-500 transition text-sm font-bold flex items-center justify-center gap-2"
                            >
                                <span>🚪</span> Cerrar Sesión
                            </button>
                            <button
                                id="btn-delete-account"
                                class="block w-full py-2 px-4 text-red-300 hover:text-red-600 font-medium rounded-lg text-xs transition"
                            >
                                ❌ Eliminar Cuenta
                            </button>
                        </div>
                    </div>
                </aside>

                <div class="lg:col-span-3 space-y-6">
                    <IdentityWarning />
                    <!-- Blindaje de Identidad Premium -->
                    <div
                        class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-full blur-3xl opacity-50 -mr-16 -mt-16 pointer-events-none"
                        >
                        </div>

                        <div
                            class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 relative z-10"
                        >
                            <div class="flex items-center gap-4">
                                <div
                                    class="bg-blue-100 p-3 rounded-xl text-2xl shadow-sm"
                                >
                                    🛡️
                                </div>
                                <div>
                                    <h3
                                        class="font-bold text-lg text-slate-800"
                                    >
                                        Blindaje de Identidad
                                    </h3>
                                    <p class="text-sm text-slate-500">
                                        Sube tu documentación para activar tu
                                        insignia de verificado.
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-blue-50 px-3 py-1 rounded-full border border-blue-100"
                            >
                                <span
                                    class="text-[10px] font-bold text-blue-600 uppercase tracking-wider"
                                    >Seguridad Garantizada</span
                                >
                            </div>
                        </div>

                        <!-- BANNERS DE RECHAZO PERSISTENTES -->
                        <div
                            id="perfil-banner-dni-rechazado"
                            class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-4"
                        >
                            <div class="flex items-start gap-3">
                                <span class="text-xl">⚠️</span>
                                <div>
                                    <p
                                        class="text-xs font-bold text-red-800 uppercase tracking-tight"
                                    >
                                        DNI Rechazado
                                    </p>
                                    <p
                                        id="perfil-motivo-dni"
                                        class="text-[10px] text-red-700 font-semibold mt-0.5 Italics"
                                    >
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div
                            id="perfil-banner-ant-rechazado"
                            class="hidden bg-red-50 border border-red-200 rounded-xl p-4 mb-4"
                        >
                            <div class="flex items-start gap-3">
                                <span class="text-xl">⚠️</span>
                                <div>
                                    <p
                                        class="text-xs font-bold text-red-800 uppercase tracking-tight"
                                    >
                                        Antecedentes Rechazados
                                    </p>
                                    <p
                                        id="perfil-motivo-ant"
                                        class="text-[10px] text-red-700 font-semibold mt-0.5 Italics"
                                    >
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <!-- DNI Upload Card -->
                            <div
                                class="border border-dashed border-slate-300 rounded-xl p-4 flex flex-col items-center justify-center gap-2 hover:bg-slate-50 transition-colors cursor-pointer group"
                                onclick="document.getElementById('file-dni').click()"
                            >
                                <div
                                    class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform"
                                >
                                    <span class="text-xl">📄</span>
                                </div>
                                <div class="text-center">
                                    <p
                                        class="text-xs font-bold text-slate-700 uppercase tracking-wide"
                                    >
                                        DNI / Pasaporte
                                    </p>
                                    <span
                                        id="status-dni"
                                        class="text-[10px] text-orange-500 font-bold bg-orange-50 px-2 py-0.5 rounded-full mt-1 inline-block"
                                        >Pendiente</span
                                    >
                                </div>
                                <input
                                    type="file"
                                    id="file-dni"
                                    class="hidden"
                                    accept="image/*,application/pdf"
                                />
                            </div>

                            <!-- Antecedentes Upload Card -->
                            <div
                                class="border border-dashed border-slate-300 rounded-xl p-4 flex flex-col items-center justify-center gap-2 hover:bg-slate-50 transition-colors cursor-pointer group"
                                onclick="document.getElementById('file-ant').click()"
                            >
                                <div
                                    class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform"
                                >
                                    <span class="text-xl">⚖️</span>
                                </div>
                                <div class="text-center">
                                    <p
                                        class="text-xs font-bold text-slate-700 uppercase tracking-wide"
                                    >
                                        Antecedentes
                                    </p>
                                    <span
                                        id="status-ant"
                                        class="text-[10px] text-orange-500 font-bold bg-orange-50 px-2 py-0.5 rounded-full mt-1 inline-block"
                                        >Pendiente</span
                                    >
                                </div>
                                <input
                                    type="file"
                                    id="file-ant"
                                    class="hidden"
                                    accept="image/*,application/pdf"
                                />
                            </div>
                        </div>
                    </div>

                    <div
                        class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative"
                    >
                        <div
                            id="overlay-lock"
                            class="absolute inset-0 bg-white/90 z-50 hidden flex-col items-center justify-center text-center p-6 backdrop-blur-sm"
                        >
                            <div class="text-6xl mb-4">⏳</div>
                            <h3 class="text-2xl font-bold text-gray-800">
                                Perfil en Revisión
                            </h3>
                            <p class="text-gray-600 mb-6 max-w-md">
                                Tu documentación está siendo validada por
                                nuestro equipo.
                            </p>
                        </div>

                        <div
                            class="flex border-b border-gray-200 overflow-x-auto no-scrollbar bg-gray-50"
                        >
                            <button
                                class="tab-btn active px-6 py-4 font-bold text-gray-700 border-b-2 border-orange-500 bg-white"
                                data-tab="datos">📝 Datos</button
                            >
                            <button
                                id="btn-seo"
                                class="tab-btn px-6 py-4 font-bold text-gray-500 hover:text-orange-600 border-b-2 border-transparent relative group"
                                data-tab="seo"
                            >
                                🌐 Web & SEO <span
                                    class="text-[10px] bg-gray-200 text-gray-600 px-1 rounded ml-1 premium-lock"
                                    >🔒</span
                                >
                            </button>
                            <button
                                id="btn-galeria"
                                class="tab-btn px-6 py-4 font-bold text-gray-500 hover:text-orange-600 border-b-2 border-transparent relative group"
                                data-tab="galeria"
                            >
                                📸 Galería <span
                                    class="text-[10px] bg-gray-200 text-gray-600 px-1 rounded ml-1 premium-lock"
                                    >🔒</span
                                >
                            </button>
                            <button
                                id="btn-presupuestos"
                                class="tab-btn px-6 py-4 font-bold text-gray-500 hover:text-orange-600 border-b-2 border-transparent relative group"
                                data-tab="presupuestos"
                            >
                                💰 Presupuestos <span
                                    class="text-[10px] bg-gray-200 text-gray-600 px-1 rounded ml-1"
                                    >🔒</span
                                >
                            </button>
                        </div>

                        <form id="form-perfil" class="p-6 md:p-8">
                            <div id="tab-datos" class="tab-content">
                                <div class="grid md:grid-cols-2 gap-6 mb-4">
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >Nombre y Apellido</label
                                        ><input
                                            type="text"
                                            id="nombre"
                                            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700"
                                            data-allow-free
                                        />
                                    </div>
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >Nombre de Fantasía (Opcional)</label
                                        ><input
                                            type="text"
                                            id="nombre_fantasia"
                                            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700"
                                            placeholder="Ej: Plomería El Rayo"
                                            data-allow-free
                                        />
                                    </div>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6 mb-4">
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >CUIT / CUIL <span
                                                class="text-red-500"
                                                >*Obligatorio</span
                                            ></label
                                        ><input
                                            type="text"
                                            id="cuit"
                                            required
                                            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700"
                                            placeholder="20-12345678-9"
                                            data-allow-free
                                        />
                                    </div>
                                </div>

                                <!-- MULTI-RUBRO Y MULTI-ZONA -->
                                <div class="grid md:grid-cols-2 gap-6 mb-4">
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >Rubros (Máx 5)</label
                                        >
                                        <div class="flex gap-2 mb-2">
                                            <select
                                                id="rubro_select"
                                                class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700 text-sm"
                                            >
                                                <option value=""
                                                    >Seleccionar Rubro...</option
                                                >
                                            </select>
                                            <button
                                                type="button"
                                                id="btn-add-rubro"
                                                class="bg-orange-500 text-white px-3 rounded-lg font-bold hover:bg-orange-600"
                                                >+</button
                                            >
                                        </div>
                                        <div
                                            id="rubros-container"
                                            class="flex flex-wrap gap-2 min-h-[40px] p-2 bg-gray-50 rounded border border-gray-200"
                                        >
                                            <!-- Chips here -->
                                        </div>
                                    </div>
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >Zonas (Máx 3)</label
                                        >
                                        <div class="flex gap-2 mb-2">
                                            <select
                                                id="zona_select"
                                                class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700 text-sm"
                                            >
                                                <option value=""
                                                    >Seleccionar Zona...</option
                                                >
                                            </select>
                                            <button
                                                type="button"
                                                id="btn-add-zona"
                                                class="bg-blue-500 text-white px-3 rounded-lg font-bold hover:bg-blue-600"
                                                >+</button
                                            >
                                        </div>
                                        <div
                                            id="zonas-container"
                                            class="flex flex-wrap gap-2 min-h-[40px] p-2 bg-gray-50 rounded border border-gray-200"
                                        >
                                            <!-- Chips here -->
                                        </div>
                                    </div>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6 mb-4">
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider"
                                            >WhatsApp (Sin 0 ni 15)</label
                                        ><input
                                            type="text"
                                            id="telefono"
                                            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700"
                                            placeholder="11 1234 5678"
                                            data-allow-free
                                        />
                                    </div>

                                    <div class="relative">
                                        <label
                                            class="flex text-xs font-bold text-slate-500 mb-2 uppercase tracking-wider justify-between"
                                            ><span
                                                >Dirección Exacta (Auto) 🇦🇷</span
                                            ><span
                                                id="geo-status"
                                                class="text-xs text-gray-400"
                                                >...</span
                                            ></label
                                        >
                                        <input
                                            type="text"
                                            id="direccion_input"
                                            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#A0522D] focus:border-[#A0522D] outline-none transition-all placeholder:text-slate-400 font-medium text-slate-700"
                                            placeholder="Calle, Altura, Ciudad..."
                                            autocomplete="off"
                                            data-allow-free
                                        />
                                        <ul
                                            id="geo-suggestions"
                                            class="absolute z-50 w-full bg-white border border-gray-200 rounded-lg shadow-lg mt-1 hidden max-h-48 overflow-y-auto"
                                        >
                                        </ul>
                                        <input
                                            type="hidden"
                                            id="latitud"
                                        /><input type="hidden" id="longitud" />
                                    </div>
                                </div>

                                <!-- NUEVOS CAMPOS: EQUIPO, MATRÍCULA, GARANTÍA -->
                                <div class="grid md:grid-cols-2 gap-6 mb-4">
                                    <!-- Equipo -->
                                    <div
