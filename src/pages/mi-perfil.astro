            /**
             * Calcula la duración en días según el tipo de plan
             * - Plan Impulso/Mensual: 30 días
             * - Plan Experto/Semestral: 180 días (6 meses)
             * - Plan Semilla: Sin vencimiento
             */
            function getPlanDuration(planType) {
                const duraciones = {
                    semilla: 0, // Sin vencimiento
                    gratuito: 0,
                    mensual: 30, // 30 días
                    impulso: 30, // 30 días
                    experto: 180, // 6 meses
                    semestral: 180, // 6 meses
                };
                return duraciones[planType] || 30;
            }

