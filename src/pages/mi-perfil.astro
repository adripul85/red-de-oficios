                        // 🔧 CORREGIR DURACIÓN DEL PLAN SI ES NECESARIA
                        // Si el plan tiene una duración incorrecta, la corregimos
                        if (
                            data.plan_inicio &&
                            data.plan_vencimiento &&
                            data.plan !== "semilla"
                        ) {
                            const planInicio = data.plan_inicio.toDate();
                            const vencimientoActual =
                                data.plan_vencimiento.toDate();
                            const duracionEsperada = getPlanDuration(data.plan);

                            if (duracionEsperada > 0) {
                                // Calcular cuál debería ser el vencimiento correcto
                                const vencimientoCorrecto = new Date(
                                    planInicio,
                                );
                                vencimientoCorrecto.setDate(
                                    vencimientoCorrecto.getDate() +
