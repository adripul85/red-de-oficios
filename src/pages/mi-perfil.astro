        <style>
            .label-input {
                @apply block text-xs font-bold text-gray-500 mb-1 uppercase tracking-wide;
            }
            .input-field {
                @apply w-full border border-gray-300 p-2 text-sm rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition;
            }
            .tab-btn.active {
                @apply text-orange-600 border-orange-500 bg-white;
            }
            .hidden {
                display: none !important;
            }
        </style>

        <script>
            import {
                db,
                auth,
                storage,
                doc as fireDoc,
                getDoc,
                setDoc,
                onSnapshot,
                updateDoc,
                arrayUnion,
                arrayRemove,
                deleteDoc,
                onAuthStateChanged,
                signOut,
                deleteUser,
                sendEmailVerification,
                reauthenticateWithPopup,
                GoogleAuthProvider,
                ref,
                uploadBytes,
                getDownloadURL,
                deleteObject,
                collection,
                query,
                orderBy,
                limit,
            } from "../firebase/client";
            import { CATEGORIES } from "../data/categories";
            import {
                recompensarAccion,
                PUNTOS_RECOMPENSA,
            } from "../utils/gamification";
            import { getAuthRedirect } from "../utils/auth-redirects";

            async function getIP() {
                try {
                    const res = await fetch(
                        "https://api.ipify.org?format=json",
                    );
                    const data = await res.json();
                    return data.ip;
                } catch (e) {
                    console.error("Error obteniendo IP:", e);
                    return null;
                }
            }

            // --- 0. ESTADO GLOBAL (Movido al inicio) ---
            let userPlan = "gratuito";
            let userData = null;
            let userServices = [];
            let userTags = [];
            let selectedRubros = [];
            let selectedZonas = [];
            let currentUserUid = null;
            let docDniUrl = null;
            let docAntUrl = null;
            let isVerified = false;

            // --- 1. HELPERS Y RENDER FUNCTIONS (HOISTING FIX) ---
            const setVal = (id, v) => {
                const el = document.getElementById(id);
                if (el) el.value = v || "";
            };
            const setText = (id, t) => {
                const el = document.getElementById(id);
                if (el) el.innerText = t || "";
            };
            const setSrc = (id, s) => {
                const el = document.getElementById(id);
                if (el) el.src = s || "";
            };

            // Definir render functions aquí arriba para que existan cuando se llaman
            function renderServices() {
                const list = document.getElementById("services-list");
                if (!list) return;
                list.innerHTML = "";
                userServices.forEach((s, i) => {
                    list.innerHTML += `<tr class="border-b"><td class="p-3 font-bold">${s.nombre}</td><td class="p-3 text-xs text-gray-500">${s.descripcion || "-"}</td><td class="p-3">$${s.min} - $${s.max}</td><td class="p-3 text-right"><button type="button" class="text-red-500 font-bold remove-service-btn" data-index="${i}">×</button></td></tr>`;
                });
                list.querySelectorAll(".remove-service-btn").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        // @ts-ignore
                        const idx = parseInt(e.target.dataset.index);
                        userServices.splice(idx, 1);
                        renderServices();
                    });
                });
            }

            function renderTags() {
                const container = document.getElementById("tags-container");
                if (!container) return;
                container.innerHTML = "";
                userTags.forEach((t, i) => {
                    container.innerHTML += `<span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-2">${t} <button type="button" class="text-red-500 font-bold remove-tag-btn" data-index="${i}">×</button></span>`;
                });
                container.querySelectorAll(".remove-tag-btn").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        // @ts-ignore
                        const idx = parseInt(e.target.dataset.index);
                        userTags.splice(idx, 1);
                        renderTags();
                    });
                });
            }

            function renderGallery(portfolio) {
                const grid = document.getElementById("gallery-grid");
                if (!grid) return;
                grid.innerHTML = "";
                console.log("🎨 Rendering Gallery V2 (With Edit Button)");

                const planLimits = {
                    gratuito: 0,
                    semilla: 0,
                    basico: 3,
                    impulso: 6,
                    mensual: 6,
                    experto: 12,
                    semestral: 12,
                };
                const userPlan = userData?.plan || "gratuito";
                const maxPhotos = planLimits[userPlan] || 0;
                const currentCount = portfolio?.length || 0;
                const limitText = document.getElementById("gallery-limit-text");
                if (limitText) {
                    limitText.textContent = `(${currentCount} de ${maxPhotos})`;
                    limitText.style.color =
                        currentCount >= maxPhotos ? "red" : "";
                }

                const activeFilter =
                    document.querySelector(".gallery-filter-btn.active")
                        ?.dataset.category || "todos";

                portfolio?.forEach((item, i) => {
                    const isLegacy = typeof item === "string";
                    const url = isLegacy ? item : item.url;
                    const title = isLegacy ? "Trabajo sin título" : item.titulo;
                    const category = isLegacy
                        ? "Sin categoría"
                        : item.categoria;
                    const desc = isLegacy
                        ? "Sube los detalles de este trabajo"
                        : item.descripcion;
                    const dateStr = isLegacy ? "Sin fecha" : item.fecha;

                    if (activeFilter !== "todos" && category !== activeFilter)
                        return;

                    grid.innerHTML += `
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-gray-100 group animate-fade-in relative">
                    <div class="aspect-[4/3] overflow-hidden relative">
                        <img src="${url}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" alt="${title}">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                            <button type="button" class="bg-blue-600 text-white p-2.5 rounded-xl hover:scale-110 active:scale-95 transition-all shadow-lg edit-img-btn" data-index="${i}" title="Editar detalles">
                                ✏️
                            </button>
                            <button type="button" class="bg-red-600 text-white p-2.5 rounded-xl hover:scale-110 active:scale-95 transition-all shadow-lg delete-img-btn" data-index="${i}" title="Eliminar trabajo">
                                🗑️
                            </button>
                        </div>
                    </div>
                    <div class="p-4">
                        <h4 class="font-bold text-gray-800 line-clamp-1 text-sm">${title}</h4>
                        <p class="text-[10px] text-gray-400 mb-2 uppercase font-bold tracking-wider">${category}</p>
                        <p class="text-xs text-gray-500 line-clamp-2 mb-3 leading-relaxed h-8">${desc}</p>
                        <div class="flex items-center gap-1.5 text-orange-600 text-[10px] font-bold mt-2">
                             <span class="text-xs">📅</span> ${dateStr.toUpperCase()}
                        </div>
                    </div>
                </div>
            `;
                });

                // Event listeners para editar
                grid.querySelectorAll(".edit-img-btn").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        const idx = parseInt(e.currentTarget.dataset.index);
                        editWorkDetail(idx);
                    });
                });

                // Event listeners para borrar
                grid.querySelectorAll(".delete-img-btn").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        const idx = parseInt(e.currentTarget.dataset.index);
                        // @ts-ignore
                        const result = await Swal.fire({
                            title: "¿Borrar trabajo?",
                            text: "Esta acción no se puede deshacer",
                            icon: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#d33",
                            cancelButtonColor: "#3085d6",
                            confirmButtonText: "Sí, borrar",
                        });

                        if (result.isConfirmed) {
                            const newPortfolio = [...portfolio];
                            newPortfolio.splice(idx, 1);
                            await updateDoc(
                                fireDoc(db, "profesionales", currentUserUid),
                                {
                                    portfolio: newPortfolio,
                                },
                            );
                            loadUserProfile(currentUserUid); // Recargar
                        }
                    });
                });
            }

            async function editWorkDetail(index) {
                const portfolio = userData.portfolio || [];
                const item = portfolio[index];
                if (!item) return;

                const isLegacy = typeof item === "string";
                const currentData = isLegacy
                    ? {
                          url: item,
                          titulo: "",
                          descripcion: "",
                          categoria: "Instalaciones",
                          fecha: "",
                      }
                    : item;

                // @ts-ignore
                const { value: formValues } = await Swal.fire({
                    title: "Editar Detalles del Trabajo",
                    html:
                        '<div class="text-left">' +
                        '<label class="block text-xs font-bold text-gray-400 uppercase mb-1">Título del Proyecto</label>' +
                        `<input id="swal-title" class="swal2-input !mt-0 !mb-4 !w-full" placeholder="ej: Instalación Eléctrica Completa" value="${currentData.titulo || ""}">` +
                        '<label class="block text-xs font-bold text-gray-400 uppercase mb-1">Categoría</label>' +
                        `<select id="swal-category" class="swal2-input !mt-0 !mb-4 !w-full">` +
                        `<option value="Instalaciones" ${currentData.categoria === "Instalaciones" ? "selected" : ""}>Instalaciones</option>` +
                        `<option value="Reparaciones" ${currentData.categoria === "Reparaciones" ? "selected" : ""}>Reparaciones</option>` +
                        `<option value="Mantenimiento" ${currentData.categoria === "Mantenimiento" ? "selected" : ""}>Mantenimiento</option>` +
                        `<option value="Urgencias" ${currentData.categoria === "Urgencias" ? "selected" : ""}>Urgencias</option>` +
                        "</select>" +
                        '<label class="block text-xs font-bold text-gray-400 uppercase mb-1">Descripción</label>' +
                        `<textarea id="swal-desc" class="swal2-textarea !mt-0 !mb-4 !w-full" placeholder="Cuéntanos un poco sobre el trabajo...">${currentData.descripcion || ""}</textarea>` +
                        '<label class="block text-xs font-bold text-gray-400 uppercase mb-1">Fecha</label>' +
                        `<input id="swal-date" type="text" class="swal2-input !mt-0 !w-full" placeholder="ej: Octubre 2023" value="${currentData.fecha || ""}">` +
                        "</div>",
                    focusConfirm: false,
                    confirmButtonText: "Guardar Cambios",
                    confirmButtonColor: "#ea580c",
                    showCancelButton: true,
                    preConfirm: () => {
                        return {
                            titulo:
                                document.getElementById("swal-title").value ||
                                "Trabajo de Calidad",
                            descripcion:
                                document.getElementById("swal-desc").value ||
                                "",
                            categoria:
                                document.getElementById("swal-category").value,
                            fecha:
                                document.getElementById("swal-date").value ||
                                "Reciente",
                        };
                    },
                });

                if (formValues) {
                    const newPortfolio = [...portfolio];
                    newPortfolio[index] = {
                        url: currentData.url,
                        ...formValues,
                        updatedAt: new Date(),
                    };

                    // @ts-ignore
                    Swal.fire({
                        title: "Guardando...",
                        didOpen: () => Swal.showLoading(),
                    });

                    await updateDoc(
                        fireDoc(db, "profesionales", currentUserUid),
                        {
                            portfolio: newPortfolio,
                        },
                    );

                    await loadUserProfile(currentUserUid);
                    // @ts-ignore
                    Swal.close();
                }
            }

            // Sistema de filtros
            document.addEventListener("click", (e) => {
                const btn = e.target.closest(".gallery-filter-btn");
                if (btn) {
                    document
                        .querySelectorAll(".gallery-filter-btn")
                        .forEach((b) => {
                            b.classList.remove(
                                "active",
                                "bg-orange-600",
                                "text-white",
                            );
                            b.classList.add("bg-gray-100", "text-gray-600");
                        });
                    btn.classList.add("active", "bg-orange-600", "text-white");
                    btn.classList.remove("bg-gray-100", "text-gray-600");
                    renderGallery(userData.portfolio || []);
                }
            });

            function renderPlanInfo(planKey) {
                const config = PLAN_DETAILS[planKey] || PLAN_DETAILS["semilla"];
                const container = document.getElementById("plan-display");
                const benefitsList = document.getElementById("plan-benefits");
                if (container) {
                    container.innerHTML = config.label;
                    container.className = `font-black text-xl mt-1 ${config.class}`;

                    // Agregar badge de días restantes si hay vencimiento
                    if (userData.plan_vencimiento && planKey !== "semilla") {
                        const vencimiento = userData.plan_vencimiento.toDate();
                        const ahora = new Date();
                        const diasRestantes = Math.ceil(
                            (vencimiento - ahora) / (1000 * 60 * 60 * 24),
                        );

                        if (diasRestantes > 0) {
                            // Check for existing badge to prevent duplicates
                            const existingBadge = document.getElementById(
                                "plan-expiration-badge",
                            );
                            if (existingBadge) existingBadge.remove();

                            const badgeColor =
                                diasRestantes <= 10
                                    ? "text-orange-600 bg-orange-50"
                                    : "text-gray-500 bg-gray-100";
                            const badge = document.createElement("div");
                            badge.id = "plan-expiration-badge"; // Unique ID
                            badge.className = `mt-2 text-xs text-center font-bold px-2 py-1 rounded ${badgeColor}`;
                            badge.innerHTML = `⏰ ${diasRestantes} día${diasRestantes > 1 ? "s" : ""} restante${diasRestantes > 1 ? "s" : ""}`;
                            container.parentElement?.appendChild(badge);
                        }
                    }
                }
                if (benefitsList)
                    benefitsList.innerHTML = config.benefits
                        .map(
                            (i) =>
                                `<li class="flex gap-2 text-xs ${i.active ? "text-gray-700" : "text-gray-400"}"><span class="${!i.active ? "grayscale opacity-50" : ""}">${i.icon}</span> ${i.text}</li>`,
                        )
                        .join("");
            }

            function renderBadges(data) {
                const c = document.getElementById("badges-container");
                if (!c) return;
                c.innerHTML = "";

                const addBadge = (text, color, icon, meaning) => {
                    const badge = document.createElement("span");
                    badge.className = `bg-${color}-100 text-${color}-700 text-[10px] font-black px-2.5 py-1 rounded-full border border-${color}-200 flex items-center gap-1 shadow-sm cursor-help active:scale-95 transition-transform select-none`;
                    badge.innerHTML = `<span class="text-xs">${icon}</span> ${text}`;
                    badge.title = meaning;

                    badge.addEventListener("click", () => {
                        // @ts-ignore
                        Swal.fire({
                            toast: true,
                            position: "top",
                            showConfirmButton: false,
                            timer: 2500,
                            iconHtml: `<span style="font-size: 20px">${icon}</span>`,
                            title: `<span style="font-size: 14px; font-weight: bold; color: #1e293b">${text}</span>`,
                            html: `<p style="font-size: 12px; color: #64748b; margin-top: 5px">${meaning}</p>`,
                            background: "#ffffff",
                            customClass: {
                                popup: "rounded-2xl border border-slate-100 shadow-xl",
                            },
                        });
                    });
                    c.appendChild(badge);
                };

                if (data.verificado || data.is_verified) {
                    addBadge(
                        "VERIFICADO",
                        "blue",
                        "🛡️",
                        "Este profesional ha validado su identidad y documentación con nuestro equipo.",
                    );
                }
                if ((data.promedio || 0) >= 4.5) {
                    addBadge(
                        "TOP PRO",
                        "yellow",
                        "⭐",
                        "Profesional con un promedio de calificaciones superior a 4.5 estrellas.",
                    );
                }

                const plan = data.plan || "semilla";
                const isExperto = plan === "experto" || plan === "semestral";
                const isImpulso =
                    plan === "impulso" ||
                    plan === "mensual" ||
                    plan === "basico";

                const planColor = isExperto
                    ? "orange"
                    : isImpulso
                      ? "purple"
                      : "slate";
                const planLabel = isExperto
                    ? "EXPERTO"
                    : isImpulso
                      ? "IMPULSO"
                      : "SEMILLA";

                addBadge(
                    `PLAN ${planLabel}`,
                    planColor,
                    "🏆",
                    `Suscripción actual: ${planLabel}. Define tus beneficios en la plataforma.`,
                );
            }

            function updateClickCounter(clicks) {
                const counter = document.getElementById("click-counter");
                if (!counter) return;

                // Normalizar plan para el chequeo (Garantizar que detectamos Semilla/Gratis)
                const currentPlan = (
                    userPlan ||
                    userData?.plan ||
                    "semilla"
                ).toLowerCase();
                const isSemilla =
                    currentPlan === "semilla" ||
                    currentPlan === "gratuito" ||
                    currentPlan === "basico" ||
                    currentPlan.includes("gratis") ||
                    currentPlan.includes("prueba");

                // Si es semilla o un plan con limite, mostrar barra
