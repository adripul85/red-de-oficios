                        // ⏰ VERIFICAR EXPIRACIÓN DEL PLAN
                        if (data.plan_vencimiento && data.plan !== "semilla") {
                            const vencimiento = data.plan_vencimiento.toDate();
                            const ahora = new Date();
                            const diasRestantes = Math.ceil(
                                (vencimiento - ahora) / (1000 * 60 * 60 * 24),
