    // Sidebar Mobile Toggle
    const btnOpenSidebar = document.getElementById("open-sidebar");

    btnOpenSidebar?.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("toggle-sidebar"));
    });
</script>
