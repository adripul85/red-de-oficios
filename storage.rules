rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para perfiles profesionales (Nueva estructura unificada)
    match /profesionales/{userId}/{path=**} {
      // Escritura: Solo el dueño del perfil
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // Máximo 10MB
      
      // Lectura: Por defecto solo el dueño y el admin (Privacidad)
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == 'oZ6sEtoOHhXGnOlrK9v2LssFDex2');
    }

    // Excepciones de lectura pública para elementos visibles del perfil
    match /profesionales/{userId}/{filename} {
      // Archivos en la raíz de la carpeta del usuario (ej: avatar_...)
      allow read: if true;
    }
    match /profesionales/{userId}/portfolio/{filename} {
      // Imágenes del portfolio de trabajos
      allow read: if true;
    }
    
    // Reglas para el portafolio legacy (storage-utils)
    match /portfolios/{userId}/{categoria}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Reglas para avatares legacy
    match /avatars/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Reglas para registros temporales (antes de tener UID)
    match /temp_registro/{filename} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Denegar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
